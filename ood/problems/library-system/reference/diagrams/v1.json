    { "from": "copy", "to": "status", "label": "in status" },
    { "from": "library", "to": "member", "label": "has many" },
    { "from": "member", "to": "loan", "label": "has many (≤5 active)" },
    { "from": "loan", "to": "copy", "label": "of" }
  ],
  "flows": [{ "name": "borrow", "path": ["member_actor", "library", "member", "loan", "copy"] }]
