{
 "version": 1,
 "title": "Bounded buffer — producers and consumers on a ring of 3 slots",
 "code": [
  "def simulate_bounded_buffer(capacity: int, script: list[str]) -> list[str]:",
  "    buf: list[str] = [\"_\"] * capacity",
  "    head = tail = count = 0",
  "    blocked_puts: list[str] = []",
  "    blocked_takes = 0",
  "    log: list[str] = []",
  "",
  "    def store(item: str) -> None:",
  "        nonlocal tail, count",
  "        buf[tail] = item",
  "        tail = (tail + 1) % capacity",
  "        count += 1",
  "",
  "    def remove() -> str:",
  "        nonlocal head, count",
  "        item = buf[head]",
  "        buf[head] = \"_\"",
  "        head = (head + 1) % capacity",
  "        count -= 1",
  "        return item",
  "",
  "    for op in script:",
  "        if op.startswith(\"put:\"):",
  "            item = op[4:]",
  "            if count == capacity:",
  "                blocked_puts.append(item)",
  "                log.append(f\"wait put {item}\")",
  "                continue",
  "            store(item)",
  "            log.append(f\"put {item}\")",
  "            if blocked_takes:",
  "                blocked_takes -= 1",
  "                log.append(f\"woken take {remove()}\")",
  "        else:",
  "            if count == 0:",
  "                blocked_takes += 1",
  "                log.append(\"wait take\")",
  "                continue",
  "            log.append(f\"take {remove()}\")",
  "            if blocked_puts:",
  "                item = blocked_puts.pop(0)",
  "                store(item)",
  "                log.append(f\"woken put {item}\")",
  "    return log"
 ],
 "view": [
