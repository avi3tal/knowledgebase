{
 "version": 1,
 "title": "State — a document workflow without a status switch",
 "code": [
  "def run_doc_workflow(events: list[str]) -> list[str]:",
  "    class State:",
  "        name = \"?\"",
  "",
  "        def handle(self, event: str) -> \"State\":",
  "            return self",
  "",
  "    class Draft(State):",
  "        name = \"draft\"",
  "",
  "        def handle(self, event: str) -> State:",
  "            if event == \"submit\":",
  "                return Review()",
  "            return self",
  "",
  "    class Review(State):",
  "        name = \"review\"",
  "",
  "        def handle(self, event: str) -> State:",
  "            if event == \"approve\":",
  "                return Published()",
  "            if event == \"reject\":",
  "                return Draft()",
  "            return self",
  "",
  "    class Published(State):",
  "        name = \"published\"",
  "",
  "        def handle(self, event: str) -> State:",
  "            if event == \"archive\":",
  "                return Archived()",
  "            return self",
  "",
  "    class Archived(State):",
  "        name = \"archived\"",
  "",
  "    class Document:",
  "        def __init__(self) -> None:",
  "            self.state: State = Draft()",
  "",
  "        def apply(self, event: str) -> str:",
  "            self.state = self.state.handle(event)",
  "            return self.state.name",
  "",
  "    doc = Document()",
  "    status = doc.state.name",
  "    history: list[str] = [status]",
  "    for event in events:",
  "        status = doc.apply(event)",
  "        history.append(status)",
  "    return history"
 ],
