      "row": 2,
      "tone": "bad"
    },
    {
      "id": "r400",
      "type": "end",
      "label": "reject 400",
      "col": 1,
      "row": 3,
      "tone": "bad"
    }
  ],
  "edges": [
    {
      "from": "req",
      "to": "auth"
    },
    {
      "from": "auth",
      "to": "rate",
