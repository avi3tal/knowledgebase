{
 "version": 1,
 "title": "Decorator — one render() call travels through stacked layers",
 "code": [
  "def render_message(text: str, layers: list[str]) -> str:",
  "    class Formatter:",
  "        def render(self, text: str) -> str:",
  "            out = text",
  "            return out",
  "",
  "    class Layer(Formatter):",
  "        def __init__(self, inner: Formatter) -> None:",
  "            self.inner = inner",
  "",
  "    class Trim(Layer):",
  "        def render(self, text: str) -> str:",
  "            text = text.strip()",
  "            out = self.inner.render(text)",
  "            return out",
  "",
  "    class Upper(Layer):",
  "        def render(self, text: str) -> str:",
  "            inner = self.inner",
  "            out = inner.render(text).upper()",
  "            return out",
  "",
  "    class Exclaim(Layer):",
  "        def render(self, text: str) -> str:",
  "            inner = self.inner",
  "            out = inner.render(text) + \"!\"",
  "            return out",
  "",
  "    kinds = {\"trim\": Trim, \"upper\": Upper, \"exclaim\": Exclaim}",
  "    formatter: Formatter = Formatter()",
  "    chain = \"Formatter\"",
  "    for name in layers:",
  "        formatter = kinds[name](formatter)",
  "        chain = f\"{name}({chain})\"",
  "    out = formatter.render(text)",
  "    return out"
 ],
