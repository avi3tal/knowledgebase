{
 "version": 1,
 "title": "Composition over inheritance — swapping a shipping policy at runtime",
 "code": [
  "def shipping_quotes(events: list[list]) -> list[str]:",
  "    class Policy:",
  "        name = \"?\"",
  "",
  "        def cost(self, kg: int) -> int:",
  "            raise NotImplementedError",
  "",
  "        def __repr__(self) -> str:",
  "            return self.name",
  "",
  "    class ByWeight(Policy):",
  "        name = \"by-weight\"",
  "",
  "        def cost(self, kg: int) -> int:",
  "            return 4 + 2 * kg",
  "",
  "    class Flat(Policy):",
  "        name = \"flat\"",
  "",
  "        def cost(self, kg: int) -> int:",
  "            return 10",
  "",
  "    class FreeOverFive(Policy):",
  "        name = \"free-over-5\"",
  "",
  "        def cost(self, kg: int) -> int:",
  "            return 0 if kg >= 5 else 7",
  "",
  "    class Shipper:",
  "        def __init__(self, policy: Policy) -> None:",
  "            self.policy = policy",
  "",
  "        def quote(self, kg: int) -> int:",
  "            return self.policy.cost(kg)",
  "",
  "    policies = {\"by-weight\": ByWeight(), \"flat\": Flat(), \"free-over-5\": FreeOverFive()}",
  "    shipper = Shipper(policies[\"by-weight\"])",
  "    policy = shipper.policy.name",
  "    quotes: list[str] = []",
  "    for verb, arg in events:",
  "        if verb == \"use\":",
  "            shipper.policy = policies[arg]",
  "            policy = arg",
  "        else:",
  "            kg = arg",
  "            price = shipper.quote(kg)",
  "            quotes.append(f\"{kg}kg {policy} = {price}\")",
  "    return quotes"
 ],
