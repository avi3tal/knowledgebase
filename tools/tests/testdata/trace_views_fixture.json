  "title": "tree",
  "code": [
   "def max_depth(root):",
   "    best = 0",
   "",
   "    def dfs(node, depth):",
   "        nonlocal best",
   "        if node is None:",
   "            return",
   "        best = max(best, depth)",
   "        dfs(node.left, depth + 1)",
   "        dfs(node.right, depth + 1)",
   "",
   "    dfs(root, 1)",
   "    return best"
