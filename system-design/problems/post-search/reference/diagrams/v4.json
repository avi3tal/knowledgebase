{
  "version": 4,
  "why": "Compose P4 (F3, N2): likes and reposts flow through a stream into a signals store, and the broker re-ranks the top ~1000 candidates with them, so 'Top' reflects engagement without reindexing posts.",
  "nodes": [
    {
      "id": "client",
      "kind": "client",
      "label": "Mobile / web app",
      "x": 40,
      "y": 200
    },
    {
      "id": "lb",
      "kind": "load-balancer",
      "label": "Load balancer",
      "x": 200,
      "y": 200
    },
    {
      "id": "postsvc",
      "kind": "service",
      "label": "Post service",
      "x": 380,
      "y": 80
    },
    {
      "id": "posts",
      "kind": "nosql",
      "label": "posts (source of truth)",
      "x": 580,
      "y": 20
    },
    {
      "id": "poststream",
      "kind": "stream",
      "label": "Post events (create / delete)",
      "x": 580,
      "y": 140
    },
    {
      "id": "indexer",
      "kind": "worker",
      "label": "Indexers (tokenize, normalise)",
      "x": 780,
      "y": 140
    },
    {
      "id": "rtindex",
      "kind": "search",
      "label": "Real-time index (last 7 days, in memory)",
      "x": 960,
      "y": 140
    },
    {
      "id": "searchsvc",
      "kind": "service",
      "label": "Search broker (scatter-gather + rank)",
      "x": 380,
      "y": 360
    },
    {
      "id": "builder",
      "kind": "worker",
      "label": "Segment builder (daily)",
      "x": 780,
      "y": 20
    },
    {
      "id": "archive",
      "kind": "search",
      "label": "Archive index (time tiers, doc-partitioned)",
      "x": 960,
      "y": 20
    },
    {
      "id": "qcache",
      "kind": "cache",
      "label": "Query result cache (short TTL)",
      "x": 580,
      "y": 420
    },
    {
      "id": "engstream",
      "kind": "stream",
      "label": "Engagement events (likes, reposts)",
      "x": 580,
      "y": 260
    },
    {
      "id": "engworker",
      "kind": "worker",
      "label": "Signal aggregator",
      "x": 780,
      "y": 260
    },
    {
      "id": "signals",
      "kind": "cache",
      "label": "Engagement signals per post",
      "x": 960,
      "y": 260
    }
  ],
  "edges": [
    {
      "from": "client",
      "to": "lb",
      "label": "POST /posts, GET /search"
    },
    {
      "from": "lb",
      "to": "postsvc",
      "label": "create / delete / like"
    },
    {
      "from": "lb",
      "to": "searchsvc",
      "label": "GET /search"
    },
    {
      "from": "postsvc",
      "to": "posts",
      "label": "write post + outbox"
    },
    {
      "from": "postsvc",
      "to": "poststream",
      "label": "post created / deleted"
    },
    {
      "from": "poststream",
      "to": "indexer",
      "label": "consume"
    },
    {
      "from": "indexer",
      "to": "rtindex",
      "label": "add docs, tombstones"
    },
    {
      "from": "searchsvc",
      "to": "rtindex",
      "label": "query recent tier"
    },
    {
      "from": "builder",
      "to": "posts",
      "label": "read a day of posts"
    },
    {
      "from": "builder",
      "to": "archive",
      "label": "publish immutable segments"
    },
    {
      "from": "searchsvc",
      "to": "archive",
      "label": "scatter to older tiers"
    },
    {
      "from": "searchsvc",
      "to": "qcache",
      "label": "hot query results"
    },
    {
      "from": "postsvc",
      "to": "engstream",
      "label": "like / repost"
    },
    {
      "from": "engstream",
      "to": "engworker",
      "label": "consume"
    },
    {
      "from": "engworker",
      "to": "signals",
      "label": "batched counts"
    },
    {
      "from": "searchsvc",
      "to": "signals",
      "label": "features for top ~1000"
    }
  ],
  "flows": [
    {
      "name": "index",
      "path": [
        "client",
        "lb",
        "postsvc",
        "poststream",
        "indexer",
        "rtindex"
      ]
    },
    {
      "name": "query",
      "path": [
        "client",
        "lb",
        "searchsvc",
        "rtindex"
      ]
    },
    {
      "name": "signals",
      "path": [
        "postsvc",
        "engstream",
        "engworker",
        "signals"
      ]
    }
  ]
}
