{
  "version": 2,
  "why": "Compose P1 (F1, N2): an inverted index fed by post events through indexer workers, so posting never waits and new posts are searchable in seconds. Flaw left: one index cluster cannot hold years of posts or the event-spike query load.",
  "nodes": [
    {
      "id": "client",
      "kind": "client",
      "label": "Mobile / web app",
      "x": 40,
      "y": 200
    },
    {
      "id": "lb",
      "kind": "load-balancer",
      "label": "Load balancer",
      "x": 200,
      "y": 200
    },
    {
      "id": "postsvc",
      "kind": "service",
      "label": "Post service",
      "x": 380,
      "y": 80
    },
    {
      "id": "posts",
      "kind": "nosql",
      "label": "posts (source of truth)",
      "x": 580,
      "y": 20
    },
    {
      "id": "poststream",
      "kind": "stream",
      "label": "Post events (create / delete)",
      "x": 580,
      "y": 140
    },
    {
      "id": "indexer",
      "kind": "worker",
      "label": "Indexers (tokenize, normalise)",
      "x": 780,
      "y": 140
    },
    {
      "id": "rtindex",
      "kind": "search",
      "label": "Search index (single cluster)",
      "x": 960,
      "y": 140
    },
    {
      "id": "searchsvc",
      "kind": "service",
      "label": "Search service",
      "x": 380,
      "y": 360
    }
  ],
  "edges": [
    {
      "from": "client",
      "to": "lb",
      "label": "POST /posts, GET /search"
    },
    {
      "from": "lb",
      "to": "postsvc",
      "label": "create / delete / like"
    },
    {
      "from": "lb",
      "to": "searchsvc",
      "label": "GET /search"
    },
    {
      "from": "postsvc",
      "to": "posts",
      "label": "write post + outbox"
    },
    {
      "from": "postsvc",
      "to": "poststream",
      "label": "post created / deleted"
    },
    {
      "from": "poststream",
      "to": "indexer",
      "label": "consume"
    },
    {
      "from": "indexer",
      "to": "rtindex",
      "label": "add docs, tombstones"
    },
    {
      "from": "searchsvc",
      "to": "rtindex",
      "label": "query recent tier"
    }
  ],
  "flows": [
    {
      "name": "index",
      "path": [
        "client",
        "lb",
        "postsvc",
        "poststream",
        "indexer",
        "rtindex"
      ]
    }
  ]
}
