{
  "version": 4,
  "why": "Compose P1 + P5 for N1 and F3: the frontier becomes priority front queues feeding per-host back queues; a politeness scheduler hands each host to one fetcher at most once per second (or its robots.txt crawl-delay, cached per host). url_meta records each fetch and content hash, and a recrawl scheduler re-enqueues pages by importance × staleness with an adaptive interval.",
  "nodes": [
    { "id": "op", "kind": "client", "label": "Operator (seeds, host policies)", "x": 40, "y": 160 },
    { "id": "api", "kind": "service", "label": "Crawl control API", "x": 200, "y": 160 },
    { "id": "frontier", "kind": "queue", "label": "Frontier: priority front queues", "x": 360, "y": 160 },
    { "id": "polite", "kind": "scheduler", "label": "Politeness scheduler (per-host back queues, ready-time heap)", "x": 520, "y": 160 },
    { "id": "fetch", "kind": "worker", "label": "Fetchers ×N (async HTTP, leases)", "x": 690, "y": 160 },
    { "id": "dns", "kind": "cache", "label": "Caching DNS resolver", "x": 600, "y": 40 },
    { "id": "robots", "kind": "cache", "label": "robots.txt cache", "x": 780, "y": 40 },
    { "id": "web", "kind": "external", "label": "Websites", "x": 860, "y": 160 },
    { "id": "pages", "kind": "blob", "label": "Raw pages (blob, batched WARC files)", "x": 860, "y": 300 },
    { "id": "parseq", "kind": "queue", "label": "Fetched-page events", "x": 680, "y": 300 },
    { "id": "parser", "kind": "worker", "label": "Parsers + link extractor", "x": 500, "y": 300 },
    { "id": "seen", "kind": "cache", "label": "Seen-URL Bloom filter", "x": 420, "y": 440 },
    { "id": "fingerprints", "kind": "nosql", "label": "Content fingerprints (hash + SimHash)", "x": 620, "y": 440 },
    { "id": "urlmeta", "kind": "nosql", "label": "url_meta (last fetch, next due, priority)", "x": 300, "y": 340 },
    { "id": "recrawl", "kind": "scheduler", "label": "Recrawl scheduler (adaptive interval)", "x": 80, "y": 400 }
  ],
  "edges": [
    { "from": "op", "to": "api", "label": "POST /seeds, PUT host policy" },
    { "from": "api", "to": "frontier" },
    { "from": "frontier", "to": "polite", "label": "by priority" },
    { "from": "polite", "to": "fetch", "label": "one host → one fetcher, ≤1 req/s" },
    { "from": "fetch", "to": "dns", "label": "resolve host" },
    { "from": "fetch", "to": "robots", "label": "allowed? crawl-delay?" },
    { "from": "fetch", "to": "web", "label": "HTTP GET (timeouts)" },
    { "from": "fetch", "to": "pages", "label": "append raw HTML" },
    { "from": "fetch", "to": "parseq", "label": "page fetched" },
    { "from": "parseq", "to": "parser" },
    { "from": "parser", "to": "seen", "label": "new URL?" },
    { "from": "parser", "to": "fingerprints", "label": "duplicate content?" },
    { "from": "parser", "to": "urlmeta", "label": "last fetch, content hash" },
    { "from": "parser", "to": "frontier", "label": "new URLs (scored)" },
    { "from": "recrawl", "to": "urlmeta", "label": "scan due pages" },
    { "from": "recrawl", "to": "frontier", "label": "re-enqueue" }
  ],
  "flows": [
    { "name": "crawl loop", "path": ["frontier", "polite", "fetch", "parseq", "parser", "frontier"] },
    { "name": "recrawl", "path": ["recrawl", "frontier", "polite", "fetch"] }
  ]
}
