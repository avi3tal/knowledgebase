{
  "version": 4,
  "why": "Compose P4 for F3: a Flink job reads the same query log, counts queries in 5-minute windows, and writes spiking ones to a small trending overlay that the suggest service merges with the index. Trending shows up in minutes while the big index keeps its hourly cycle.",
  "nodes": [
    { "id": "client", "kind": "client", "label": "Search box (browser / app)", "x": 40, "y": 200 },
    { "id": "cdn", "kind": "cdn", "label": "CDN edge cache (short prefixes)", "x": 200, "y": 200 },
    { "id": "lb", "kind": "load-balancer", "label": "Load balancer", "x": 360, "y": 200 },
    { "id": "suggest", "kind": "service", "label": "Suggest service ×N", "x": 520, "y": 110 },
    { "id": "searchsvc", "kind": "service", "label": "Search service", "x": 520, "y": 330 },
    { "id": "prefixkv", "kind": "cache", "label": "Prefix index: prefix → top 10 (Redis, sharded)", "x": 720, "y": 170 },
    { "id": "logs", "kind": "stream", "label": "Query log (Kafka)", "x": 700, "y": 330 },
    { "id": "lake", "kind": "blob", "label": "Query log archive (hourly files)", "x": 700, "y": 450 },
    { "id": "builder", "kind": "worker", "label": "Index builder (batch: count, decay, top-k)", "x": 880, "y": 260 },
    { "id": "counts", "kind": "nosql", "label": "query_counts (query, day, count)", "x": 880, "y": 410 },
    { "id": "trend", "kind": "worker", "label": "Trending detector (Flink, 5-min windows)", "x": 880, "y": 90 },
    { "id": "trendkv", "kind": "cache", "label": "Trending overlay: prefix → hot queries", "x": 720, "y": 30 }
  ],
  "edges": [
    { "from": "client", "to": "cdn", "label": "GET /suggest?q=pre (debounced)" },
    { "from": "cdn", "to": "lb", "label": "cache miss / search" },
    { "from": "lb", "to": "suggest" },
    { "from": "lb", "to": "searchsvc" },
    { "from": "suggest", "to": "prefixkv", "label": "GET prefix" },
    { "from": "searchsvc", "to": "logs", "label": "query issued (async)" },
    { "from": "logs", "to": "lake", "label": "sink hourly files" },
    { "from": "builder", "to": "lake", "label": "read new hour" },
    { "from": "builder", "to": "counts", "label": "decayed counts" },
    { "from": "builder", "to": "prefixkv", "label": "load index v+1, flip version" },
    { "from": "logs", "to": "trend" },
    { "from": "trend", "to": "trendkv", "label": "hot queries (TTL 2 h)" },
    { "from": "suggest", "to": "trendkv", "label": "merge overlay" }
  ],
  "flows": [
    { "name": "suggest", "path": ["client", "cdn", "lb", "suggest", "prefixkv"] },
    { "name": "trending", "path": ["searchsvc", "logs", "trend", "trendkv"] }
  ]
}
