{
  "version": 4,
  "why": "Compose P4 (F3): dispatchers keep the last 50 comments per video in Redis, served on join through the CDN with a 1 s TTL, so a million joiners cause a handful of origin reads.",
  "nodes": [
    { "id": "client", "kind": "client", "label": "Viewers' apps", "x": 60, "y": 260 },
    { "id": "cdn", "kind": "cdn", "label": "CDN (recent comments, 1 s TTL)", "x": 220, "y": 60 },
    { "id": "lb", "kind": "load-balancer", "label": "Load balancer", "x": 220, "y": 320 },
    { "id": "api", "kind": "service", "label": "Comment service ×N (validate, filter)", "x": 400, "y": 160 },
    { "id": "gw", "kind": "service", "label": "Comment gateways ×200 (SSE)", "x": 400, "y": 420 },
    { "id": "stream", "kind": "stream", "label": "Comment log (Kafka, key = video_id)", "x": 590, "y": 160 },
    { "id": "pubsub", "kind": "queue", "label": "Per-video pub/sub channels (Redis)", "x": 590, "y": 420 },
    { "id": "persister", "kind": "worker", "label": "Persister workers", "x": 770, "y": 60 },
    { "id": "comments", "kind": "nosql", "label": "comments (Cassandra: video_id, time)", "x": 950, "y": 60 },
    { "id": "dispatcher", "kind": "worker", "label": "Dispatchers: batch + sample per video (500 ms)", "x": 770, "y": 300 },
    { "id": "recent", "kind": "cache", "label": "Recent 50 per video (Redis list)", "x": 950, "y": 200 }
  ],
  "edges": [
    { "from": "client", "to": "lb", "label": "POST comment / SSE subscribe" },
    { "from": "lb", "to": "api", "label": "POST /videos/{id}/comments" },
    { "from": "lb", "to": "gw", "label": "SSE /videos/{id}/comments/stream" },
    { "from": "client", "to": "cdn", "label": "GET recent 50 on join" },
    { "from": "cdn", "to": "api", "label": "cache miss" },
    { "from": "api", "to": "stream", "label": "append (ack after write)" },
    { "from": "api", "to": "recent", "label": "read last 50" },
    { "from": "stream", "to": "persister", "label": "consume" },
    { "from": "persister", "to": "comments", "label": "batched insert" },
    { "from": "stream", "to": "dispatcher", "label": "consume (partition = video)" },
    { "from": "dispatcher", "to": "recent", "label": "LPUSH + LTRIM 50" },
    { "from": "dispatcher", "to": "pubsub", "label": "publish one batch / 500 ms" },
    { "from": "gw", "to": "pubsub", "label": "SUBSCRIBE video:{id} (once per gateway)" },
    { "from": "pubsub", "to": "gw", "label": "batch → local viewers" }
  ],
  "flows": [
    {
      "name": "post",
      "path": ["client", "lb", "api", "stream"]
    },
    {
      "name": "live",
      "path": ["stream", "dispatcher", "pubsub", "gw"]
    },
    {
      "name": "join",
      "path": ["client", "cdn", "api", "recent"]
    }
  ]
}
