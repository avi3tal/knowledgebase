    { "id": "api", "kind": "service", "label": "Comment service ×N (validate, filter)", "x": 400, "y": 160 },
    { "id": "gw", "kind": "service", "label": "Comment gateways ×200 (SSE)", "x": 400, "y": 420 },
    { "id": "pubsub", "kind": "queue", "label": "Per-video pub/sub channels (Redis)", "x": 590, "y": 420 },
    { "id": "comments", "kind": "sql", "label": "comments (single SQL)", "x": 950, "y": 60 }
  ],
  "edges": [
    { "from": "client", "to": "lb", "label": "POST comment / SSE subscribe" },
    { "from": "lb", "to": "api", "label": "POST /videos/{id}/comments" },
    { "from": "lb", "to": "gw", "label": "SSE /videos/{id}/comments/stream" },
