{
  "version": 4,
  "why": "Compose P3 (F3, F4): consumer groups with a coordinator that assigns partitions to members and stores committed offsets in a compacted internal topic, so members share work and resume after restarts. Disks still grow forever.",
  "nodes": [
    { "id": "producer", "kind": "client", "label": "Producers (client lib: partitioner, batching)", "x": 60, "y": 140 },
    { "id": "consumer", "kind": "client", "label": "Consumer group members", "x": 60, "y": 380 },
    { "id": "follower", "kind": "service", "label": "Brokers: follower replicas (ISR)", "x": 280, "y": 20 },
    { "id": "leader", "kind": "service", "label": "Brokers ×40: partition leaders", "x": 280, "y": 160 },
    { "id": "groupcoord", "kind": "service", "label": "Group coordinator (on a broker)", "x": 280, "y": 380 },
    { "id": "controller", "kind": "coordinator", "label": "Controller quorum (KRaft / Raft ×3)", "x": 540, "y": 20 },
    { "id": "segments", "kind": "blob", "label": "Partition logs: segments + offset index (local disk)", "x": 540, "y": 200 },
    { "id": "offsets", "kind": "stream", "label": "__consumer_offsets (compacted topic)", "x": 540, "y": 380 }
  ],
  "edges": [
    { "from": "producer", "to": "leader", "label": "produce(topic, key, batch), acks=all" },
    { "from": "leader", "to": "segments", "label": "append batch (sequential)" },
    { "from": "consumer", "to": "leader", "label": "fetch(partition, offset)" },
    { "from": "follower", "to": "leader", "label": "fetch from offset (replicate)" },
    { "from": "follower", "to": "segments", "label": "append replica copy" },
    { "from": "leader", "to": "controller", "label": "heartbeat / ISR shrink + expand" },
    { "from": "controller", "to": "leader", "label": "elect leader from ISR (new epoch)" },
    { "from": "controller", "to": "follower", "label": "leader + ISR updates" },
    { "from": "consumer", "to": "groupcoord", "label": "join group / heartbeat / commit offset" },
    { "from": "groupcoord", "to": "offsets", "label": "write committed offset" },
    { "from": "offsets", "to": "groupcoord", "label": "reload on coordinator failover" }
  ],
  "flows": [
    {
      "name": "produce",
      "path": ["producer", "leader", "segments"]
    },
    {
      "name": "consume",
      "path": ["consumer", "groupcoord", "offsets"]
    }
  ]
}
