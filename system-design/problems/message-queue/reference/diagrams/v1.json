    { "id": "leader", "kind": "service", "label": "Single broker (in-memory queue)", "x": 280, "y": 260 },
    { "id": "db", "kind": "sql", "label": "messages table (insert / delete per ack)", "x": 540, "y": 260 }
  ],
  "edges": [
