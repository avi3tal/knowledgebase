{
  "version": 4,
  "why": "Compose P3 and P4 (F4, F5, F6, N2): a read-through cache in front of sharded metadata, search via an index fed by change events, and view events aggregated in batches instead of a write per view.",
  "nodes": [
    {
      "id": "client",
      "kind": "client",
      "label": "Viewer / creator app (ABR player)",
      "x": 60,
      "y": 240
    },
    {
      "id": "lb",
      "kind": "load-balancer",
      "label": "API gateway / load balancer",
      "x": 240,
      "y": 140
    },
    {
      "id": "cdn",
      "kind": "cdn",
      "label": "CDN edge (segments + manifests)",
      "x": 240,
      "y": 400
    },
    {
      "id": "api",
      "kind": "service",
      "label": "Video API (watch page, metadata, search)",
      "x": 430,
      "y": 140
    },
    {
      "id": "upload",
      "kind": "service",
      "label": "Upload service (resumable)",
      "x": 430,
      "y": 300
    },
    {
      "id": "cache",
      "kind": "cache",
      "label": "Metadata cache (Redis)",
      "x": 620,
      "y": 60
    },
    {
      "id": "vmeta",
      "kind": "sql",
      "label": "Video metadata (sharded by video_id)",
      "x": 800,
      "y": 60
    },
    {
      "id": "search",
      "kind": "search",
      "label": "Search index (Elasticsearch)",
      "x": 960,
      "y": 60
    },
    {
      "id": "events",
      "kind": "stream",
      "label": "View + metadata events (Kafka)",
      "x": 620,
      "y": 200
    },
    {
      "id": "indexer",
      "kind": "worker",
      "label": "Search indexer",
      "x": 800,
      "y": 140
    },
    {
      "id": "counter",
      "kind": "worker",
      "label": "View counter (windowed, deduped)",
      "x": 800,
      "y": 240
    },
    {
      "id": "views",
      "kind": "nosql",
      "label": "view_counts",
      "x": 960,
      "y": 240
    },
    {
      "id": "raw",
      "kind": "blob",
      "label": "Raw uploads (object storage)",
      "x": 620,
      "y": 290
    },
    {
      "id": "orch",
      "kind": "scheduler",
      "label": "Pipeline orchestrator (DAG per video)",
      "x": 620,
      "y": 380
    },
    {
      "id": "tasks",
      "kind": "queue",
      "label": "Encode tasks (segment × rendition)",
      "x": 800,
      "y": 380
    },
    {
      "id": "workers",
      "kind": "worker",
      "label": "Transcode workers ×N (ffmpeg)",
      "x": 960,
      "y": 380
    },
    {
      "id": "media",
      "kind": "blob",
      "label": "Encoded segments + manifests (origin)",
      "x": 620,
      "y": 470
    }
  ],
  "edges": [
    {
      "from": "client",
      "to": "lb",
      "label": "upload / watch page"
    },
    {
      "from": "lb",
      "to": "upload",
      "label": "resumable upload (chunks)"
    },
    {
      "from": "upload",
      "to": "raw",
      "label": "write original"
    },
    {
      "from": "upload",
      "to": "orch",
      "label": "upload complete"
    },
    {
      "from": "orch",
      "to": "tasks",
      "label": "fan out segment × rendition"
    },
    {
      "from": "tasks",
      "to": "workers"
    },
    {
      "from": "workers",
      "to": "raw",
      "label": "read segment"
    },
    {
      "from": "workers",
      "to": "media",
      "label": "write encoded segments + manifest"
    },
    {
      "from": "orch",
      "to": "vmeta",
      "label": "status = ready, renditions"
    },
    {
      "from": "client",
      "to": "cdn",
      "label": "GET manifest + segments (ABR)"
    },
    {
      "from": "cdn",
      "to": "media",
      "label": "origin pull on miss"
    },
    {
      "from": "lb",
      "to": "api"
    },
    {
      "from": "api",
      "to": "cache",
      "label": "video metadata (read-through)"
    },
    {
      "from": "api",
      "to": "vmeta",
      "label": "cache miss / edits"
    },
    {
      "from": "api",
      "to": "search",
      "label": "search query"
    },
    {
      "from": "api",
      "to": "events",
      "label": "view + metadata-change events"
    },
    {
      "from": "events",
      "to": "indexer"
    },
    {
      "from": "indexer",
      "to": "search",
      "label": "index title, tags, channel"
    },
    {
      "from": "events",
      "to": "counter"
    },
    {
      "from": "counter",
      "to": "views",
      "label": "batched increments"
    }
  ],
  "flows": [
    {
      "name": "playback",
      "path": [
        "client",
        "cdn",
        "media"
      ]
    },
    {
      "name": "transcode",
      "path": [
        "upload",
        "orch",
        "tasks",
        "workers",
        "media"
      ]
    },
    {
      "name": "views",
      "path": [
        "api",
        "events",
        "counter",
        "views"
      ]
    }
  ]
}
