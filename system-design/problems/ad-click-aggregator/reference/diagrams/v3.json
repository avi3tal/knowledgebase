{
  "version": 3,
  "why": "Compose P3 + P5 for F4 and N2: Flink drops repeated signed impression ids using checkpointed keyed state and upserts by (ad_id, minute), so restarts can't double-count; raw clicks are archived to object storage and a nightly Spark job recomputes exact daily counts, overwrites them and alerts on drift.",
  "nodes": [
    { "id": "user", "kind": "client", "label": "Browser (ad click)", "x": 40, "y": 120 },
    { "id": "adv", "kind": "client", "label": "Advertiser dashboard", "x": 40, "y": 400 },
    { "id": "landing", "kind": "external", "label": "Advertiser landing page", "x": 180, "y": 30 },
    { "id": "lb", "kind": "load-balancer", "label": "Load balancer", "x": 180, "y": 250 },
    { "id": "clicksvc", "kind": "service", "label": "Click redirect service ×N", "x": 340, "y": 120 },
    { "id": "querysvc", "kind": "service", "label": "Query service", "x": 340, "y": 400 },
    { "id": "clicks", "kind": "stream", "label": "Kafka: click events (partitioned by ad_id)", "x": 520, "y": 120 },
    { "id": "agg", "kind": "worker", "label": "Flink: 1-min windows per ad (event time, dedup)", "x": 720, "y": 120 },
    { "id": "olap", "kind": "sql", "label": "OLAP store: clicks per ad per minute + hourly rollups", "x": 720, "y": 400 },
    { "id": "ckpt", "kind": "blob", "label": "Flink checkpoints (window + dedup state)", "x": 900, "y": 40 },
    { "id": "lake", "kind": "blob", "label": "Raw clicks archive (Parquet, 90 days)", "x": 520, "y": 270 },
    { "id": "batch", "kind": "worker", "label": "Nightly reconciliation (Spark)", "x": 900, "y": 270 }
  ],
  "edges": [
    { "from": "user", "to": "lb", "label": "GET /click/{impression_id}" },
    { "from": "lb", "to": "clicksvc" },
    { "from": "clicksvc", "to": "clicks", "label": "click event (acks=all)" },
    { "from": "user", "to": "landing", "label": "follow 302" },
    { "from": "clicks", "to": "agg" },
    { "from": "agg", "to": "olap", "label": "upsert (ad_id, minute) → count" },
    { "from": "adv", "to": "lb", "label": "GET /ads/{id}/metrics" },
    { "from": "lb", "to": "querysvc" },
    { "from": "querysvc", "to": "olap", "label": "aggregate query" },
    { "from": "agg", "to": "ckpt", "label": "checkpoint every 30 s" },
    { "from": "clicks", "to": "lake", "label": "archive raw (hourly)" },
    { "from": "batch", "to": "lake", "label": "read yesterday" },
    { "from": "batch", "to": "olap", "label": "overwrite day with exact counts" }
  ],
  "flows": [
    { "name": "click", "path": ["user", "lb", "clicksvc", "clicks"] },
    { "name": "aggregate", "path": ["clicks", "agg", "olap"] },
    { "name": "reconcile", "path": ["clicks", "lake", "batch", "olap"] }
  ]
}
