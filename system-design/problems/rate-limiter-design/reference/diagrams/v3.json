{
  "version": 3,
  "why": "Compose P4 for F2 + N3: limits become data (rules DB behind a rules service, cached in every gateway) so operators change them without a deploy, and each rule says whether to fail open (with a local fallback limit) or closed when Redis times out. Allow/deny events stream to a metrics worker off the hot path.",
  "nodes": [
    { "id": "client", "kind": "client", "label": "API caller", "x": 40, "y": 200 },
    { "id": "admin", "kind": "client", "label": "Operator console", "x": 40, "y": 420 },
    { "id": "lb", "kind": "load-balancer", "label": "Load balancer", "x": 200, "y": 200 },
    { "id": "gw", "kind": "api-gateway", "label": "API gateways + limiter (rules cached)", "x": 400, "y": 200 },
    { "id": "buckets", "kind": "cache", "label": "Redis cluster: token buckets (sharded, replicas)", "x": 400, "y": 40 },
    { "id": "rulesvc", "kind": "service", "label": "Rules service", "x": 400, "y": 420 },
    { "id": "rules", "kind": "sql", "label": "Rules DB (limit config)", "x": 640, "y": 420 },
    { "id": "api", "kind": "service", "label": "API servers ×40", "x": 640, "y": 200 },
    { "id": "appdb", "kind": "sql", "label": "App database", "x": 880, "y": 200 },
    { "id": "decisions", "kind": "stream", "label": "Decision events", "x": 640, "y": 310 },
    { "id": "metrics", "kind": "worker", "label": "Limiter metrics worker", "x": 880, "y": 310 }
  ],
  "edges": [
    { "from": "client", "to": "lb", "label": "HTTP request" },
    { "from": "lb", "to": "gw" },
    { "from": "gw", "to": "buckets", "label": "atomic take (Lua), 2 ms timeout" },
    { "from": "gw", "to": "rulesvc", "label": "refresh rules every 5 s" },
    { "from": "gw", "to": "api", "label": "allowed requests only" },
    { "from": "gw", "to": "decisions", "label": "allow/deny event (async)" },
    { "from": "decisions", "to": "metrics" },
    { "from": "admin", "to": "rulesvc", "label": "PUT /admin/rules" },
    { "from": "rulesvc", "to": "rules", "label": "versioned write" },
    { "from": "api", "to": "appdb", "label": "business data" }
  ],
  "flows": [
    { "name": "decision", "path": ["client", "lb", "gw", "buckets"] },
    { "name": "rule change", "path": ["admin", "rulesvc", "rules"] }
  ]
}
