      "input": {
        "durations": [8, 1, 1, 8, 1, 1, 8, 1, 1],
        "servers": 3,
        "strategy": "round-robin"
      },
      "view": [
        {
          "id": "durations",
          "type": "array",
          "var": "durations",
          "label": "request durations (one arrives per tick)",
          "pointers": {
            "now": "i"
          }
        },
        {
          "id": "active",
          "type": "array",
          "var": "active",
          "label": "active connections per server",
          "pointers": {
            "target": "target"
          }
        },
        {
          "id": "assigned",
          "type": "array",
          "var": "assigned",
          "label": "server chosen per request"
        },
        {
          "id": "vars",
          "type": "vars",
          "vars": ["target", "peak"]
        }
      ],
      "checks": [
        {
          "input": {
            "durations": [8, 1, 1, 8, 1, 1, 8, 1, 1],
            "servers": 3,
            "strategy": "round-robin"
          },
          "expected": {
            "assigned": [0, 1, 2, 0, 1, 2, 0, 1, 2],
            "peak": 3
          }
        },
        {
          "input": {
            "durations": [3, 3, 3],
            "servers": 3,
            "strategy": "round-robin"
          },
          "expected": {
            "assigned": [0, 1, 2],
            "peak": 1
          }
        },
        {
          "input": {
            "durations": [1, 1, 1, 1],
            "servers": 2,
            "strategy": "round-robin"
          },
          "expected": {
            "assigned": [0, 1, 0, 1],
            "peak": 1
          }
        }
      ]
    },
