{
 "version": 1,
 "title": "Round robin — 3 servers, every third request is slow",
 "code": [
  "def balance(durations: list[int], servers: int, strategy: str) -> dict[str, object]:",
  "    active = [0] * servers  # open connections per server",
  "    ends: list[list[int]] = []  # [finish_time, server] of open requests",
  "    assigned: list[int] = []",
  "    peak = 0",
  "    for i in range(len(durations)):",
  "        for job in [j for j in ends if j[0] <= i]:",
  "            active[job[1]] -= 1",
  "            ends.remove(job)",
  "        if strategy == \"round-robin\":",
  "            target = i % servers",
  "        else:",
  "            target = active.index(",
  "                min(active)",
  "            )",
  "        active[target] += 1",
  "        ends.append([i + durations[i], target])",
  "        assigned.append(target)",
  "        peak = max(peak, active[target])",
  "    return {\"assigned\": assigned, \"peak\": peak}"
 ],
 "view": [
  {
   "id": "durations",
   "type": "array",
   "var": "durations",
   "label": "request durations (one arrives per tick)",
   "pointers": {
    "now": "i"
   }
  },
  {
   "id": "active",
   "type": "array",
