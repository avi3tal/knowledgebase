 "steps": [
  {
   "text": "Decrypt once at the proxy: certificates live here, not on every service.",
   "nodes": [
    "in",
    "tls"
   ],
   "edges": [
    "in>tls"
   ]
  },
  {
   "text": "Match host and path against the route table: /api/cart/* → checkout pool.",
   "nodes": [
    "match",
    "pool"
   ],
   "edges": [
    "tls>match",
    "match>pool"
   ]
  },
  {
   "text": "The pool has healthy instances (the health checker keeps this list fresh).",
   "nodes": [
    "hl"
   ],
   "edges": [
    "pool>hl",
    "hl>pick"
   ]
  },
  {
   "text": "Pick the instance with the fewest requests in flight: slow instances naturally get less.",
   "nodes": [
    "pick",
    "fwd"
   ],
   "edges": [
    "hl>pick",
    "pick>fwd"
   ]
  },
  {
   "text": "Forward with a timeout; a normal response goes straight back.",
   "nodes": [
    "err",
    "ok"
   ],
   "edges": [
    "fwd>err",
    "err>ok"
   ]
  }
 ],
 "scenarios": [
  {
   "name": "Instance returns 503",
   "tone": "edge",
   "summary": "One retry on another instance hides a single bad instance, but only for idempotent requests, and with a retry budget so retries don't double the load.",
   "steps": [
    {
     "text": "Same route and pool; the chosen instance is overloaded.",
     "nodes": [
      "pool",
      "pick"
     ],
     "edges": [
      "match>pool",
      "pool>hl",
      "hl>pick",
      "pick>fwd"
     ]
    },
    {
     "text": "It answers 503 after 200 ms.",
     "nodes": [
      "fwd",
      "err"
     ],
     "edges": [
      "fwd>err"
     ]
    },
    {
     "text": "GET /api/cart is idempotent: retry once on a different instance. A POST /checkout is not retried unless it carries an idempotency key.",
     "nodes": [
      "retry",
      "r2"
     ],
     "edges": [
      "err>retry",
      "retry>r2"
     ]
    }
   ]
  },
  {
   "name": "Whole pool unhealthy",
   "tone": "failure",
   "summary": "No healthy checkout instance: fail fast with 503 and a friendly page instead of queueing requests until every proxy runs out of connections.",
   "steps": [
    {
     "text": "A bad deploy makes every checkout instance fail its health check.",
     "fail": [
      "pick"
     ],
     "nodes": [
      "pool",
      "hl"
     ],
     "edges": [
      "pool>hl"
     ]
    },
    {
     "text": "The proxy has nowhere to send /api/cart: return 503 with Retry-After immediately.",
     "nodes": [
      "none"
     ],
     "edges": [
      "hl>none"
     ]
    },
    {
     "text": "Other routes still work: / and /api/search use different pools.",
     "nodes": [
      "match",
      "pool"
     ],
     "edges": [
      "tls>match",
      "match>pool"
     ]
    }
   ]
  },
