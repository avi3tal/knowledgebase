 "steps": [
  {
   "text": "Must the same user or key reach the same server (a local cache, a WebSocket room)? Hash on it, with consistent hashing so adding a server moves few keys.",
   "nodes": [
    "start",
    "aff",
    "hash"
   ],
   "edges": [
    "start>aff",
    "aff>hash"
   ]
  },
  {
   "text": "Do request costs vary widely (uploads, long polls, LLM calls)? Route by load: least connections, or power of two choices.",
   "nodes": [
    "vary",
    "lc"
   ],
   "edges": [
    "aff>vary",
    "vary>lc"
   ]
  },
  {
   "text": "Are some machines bigger than others? Give them more turns with weighted round robin.",
   "nodes": [
    "size",
    "wrr"
   ],
   "edges": [
    "vary>size",
    "size>wrr"
   ]
  },
  {
   "text": "Otherwise, plain round robin is simple, stateless and good enough.",
   "nodes": [
