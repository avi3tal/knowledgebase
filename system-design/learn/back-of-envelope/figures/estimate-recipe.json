 "steps": [
  {
   "text": "Say the assumptions out loud: DAU, actions per user, object size, retention, replicas.",
   "nodes": [
    "assume"
   ]
  },
  {
   "text": "Multiply to a daily volume, separately for reads and writes: 10 M users × 50 views = 500 M reads/day.",
   "nodes": [
    "daily"
   ],
   "edges": [
    "assume>daily"
   ]
  },
  {
   "text": "Divide by ~1e5 seconds per day: 500 M / 86 400 ≈ 5 800 reads/s on average.",
   "nodes": [
    "qps"
   ],
   "edges": [
    "daily>qps"
   ]
  },
  {
   "text": "Traffic isn't flat. Multiply by a peak factor: 5 800 × 3 ≈ 17 000 reads/s.",
   "nodes": [
    "peak"
   ],
   "edges": [
    "qps>peak"
   ]
  },
  {
   "text": "Storage = writes/day × size × days × replicas. Egress = QPS × bytes per response × 8 for bits.",
   "nodes": [
    "size"
   ],
   "edges": [
    "peak>size"
   ]
  },
  {
   "text": "Tie each number to a box: \"17k reads/s → cache and replicas\". A number that changes nothing wasted your time.",
   "nodes": [
