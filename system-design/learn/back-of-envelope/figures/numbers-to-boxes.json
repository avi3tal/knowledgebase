 "steps": [
  {
   "text": "Read load first. One database handles a few thousand reads/s comfortably; beyond ~10k/s, a cache (~100k ops/s per node) and read replicas take it.",
   "nodes": [
    "start",
    "reads",
    "cache"
   ],
   "edges": [
    "start>reads",
    "reads>cache"
   ]
  },
  {
   "text": "Write load. Caches and replicas don't add write capacity; past what one primary can take, partition the data.",
   "nodes": [
    "writes",
    "shard"
   ],
   "edges": [
    "reads>writes",
    "writes>shard"
   ]
  },
  {
   "text": "Size. Large binary objects go to object storage with only metadata in a DB; many TB of rows means sharding.",
   "nodes": [
    "data",
    "blob"
   ],
   "edges": [
    "writes>data",
    "data>blob"
   ]
  },
  {
   "text": "Bandwidth. Gigabits per second of the same static content belong at the edge, not on your servers.",
   "nodes": [
    "egress",
    "cdn"
   ],
   "edges": [
    "data>egress",
    "egress>cdn"
   ]
  },
  {
   "text": "All no? Say so: \"one database and a couple of app servers handle this\". That is a strong answer too.",
