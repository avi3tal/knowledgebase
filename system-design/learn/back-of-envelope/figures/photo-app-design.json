 "steps": [
  {
   "text": "Egress ≈ 23 Gbps (5 800 reads/s × 500 KB × 8). The CDN serves photo bytes from the edge and only goes to the origin on a miss.",
   "nodes": [
    "client",
    "cdn",
    "blob"
   ],
   "edges": [
    "client>cdn",
    "cdn>blob"
   ]
  },
  {
   "text": "Peak ≈ 17 400 metadata reads/s: too much for one database, easy for a few stateless API servers behind a load balancer.",
   "nodes": [
    "client",
    "lb",
    "api"
   ],
   "edges": [
    "client>lb",
    "lb>api"
   ]
  },
  {
   "text": "Read:write ≈ 250:1, so optimise the read path: a cache holds hot metadata, and the DB (plus read replicas) serves misses. 23 writes/s is trivial for one primary.",
   "nodes": [
    "api",
    "cache",
    "db"
   ],
   "edges": [
    "api>cache",
    "api>db"
   ]
  },
  {
   "text": "Storage ≈ 5 475 TB over 5 years with 3 replicas: that is object storage, never database rows. Metadata is ~1 KB per photo, about 2 GB/day.",
   "nodes": [
    "api",
    "blob"
   ],
   "edges": [
    "api>blob"
   ]
  }
