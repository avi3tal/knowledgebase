 "steps": [
  {
   "text": "Start from the peak, not the average: 500 downloads/s and 24 000 feed polls/s.",
   "nodes": [
    "dl",
    "polls"
   ]
  },
  {
   "text": "Bytes: 500 × 60 MB × 8 = 240 Gbps. One server NIC carries ~10–25 Gbps, and listeners are everywhere, so this needs a CDN. At 95% hits the edges send ~228 Gbps and ~12 Gbps leaves the origin.",
   "nodes": [
    "dl",
    "cdn"
   ],
   "edges": [
    "dl>cdn",
    "cdn>shield"
   ]
  },
  {
   "text": "Misses: a new episode is requested at hundreds of edges in the same minute. An origin shield collapses them into one fetch per episode per region, so the store never sees the stampede.",
   "nodes": [
    "cdn",
    "shield",
    "blob"
   ],
   "edges": [
    "cdn>shield",
    "shield>blob"
   ]
  },
  {
   "text": "Size: 4.5 TB/day grows to ~1.6 PB a year, far past any database or file server: an object store. Most downloads are of recent episodes, so move older files to a cheaper cold tier.",
   "nodes": [
    "blob",
    "cold"
   ],
   "edges": [
    "blob>cold"
   ]
  },
  {
   "text": "Polls: 24 000/s is past one database, but a feed changes about once a week. A cache with ~99% hits leaves ~240 builds/s for the builder and ~240 reads/s for the DB: one primary is plenty.",
   "nodes": [
    "polls",
    "fcache",
    "feed",
    "db"
   ],
   "edges": [
    "polls>fcache",
    "fcache>feed",
    "feed>db"
   ]
  }
 ],
