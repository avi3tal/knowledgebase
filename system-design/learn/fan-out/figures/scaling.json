{
 "kind": "architecture",
 "title": "Scaling the inbox: from pull on read to regional fan-out",
 "caption": "Each stage removes the bottleneck of the previous one; switch the 📈 tabs to grow the system.",
 "base_name": "v1: pull on read",
 "nodes": [
  {
   "id": "u",
   "kind": "client",
   "label": "Watchers",
   "x": 0,
   "y": 120
  },
  {
   "id": "api",
   "kind": "service",
   "label": "Inbox API",
   "sub": "query on every open",
   "x": 280,
   "y": 120
  },
  {
   "id": "db",
   "kind": "sql",
   "label": "Repo DB",
   "sub": "events by repo",
   "x": 560,
   "y": 120
  }
 ],
 "edges": [
  {
   "from": "u",
   "to": "api"
  },
  {
   "from": "api",
   "to": "db",
   "label": "N watched repos"
  }
 ],
 "steps": [
  {
   "text": "On each open, the API loads the user's watched repos, fetches recent events from each and merges them. Writes cost nothing.",
   "nodes": [
    "u",
    "api"
   ],
   "edges": [
    "u>api"
   ]
  },
  {
   "text": "Fine while people watch a few repos. Someone watching 400 repos makes 400 queries per open, and the DB becomes the bottleneck as opens grow.",
   "nodes": [
    "api",
    "db"
   ],
   "edges": [
    "api>db"
   ]
  }
 ],
 "scenarios": [
  {
