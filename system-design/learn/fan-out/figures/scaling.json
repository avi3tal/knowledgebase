   ],
   "steps": [
    {
     "text": "A watcher threshold in config splits repos into pushed and merged.",
     "nodes": [
      "cfg",
      "fan"
     ],
     "edges": [
      "log>fan",
      "cfg>fan"
     ]
    },
    {
     "text": "Write cost per event is now capped by the threshold; popular repos cost one write.",
     "nodes": [
      "fan",
