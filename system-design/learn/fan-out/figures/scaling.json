     "label": "Hot-repo recents",
     "x": 540,
     "y": 200
    },
    {
     "id": "api",
     "kind": "service",
     "label": "Inbox API",
     "sub": "merge",
     "x": 820,
     "y": 120
    }
   ],
   "edges": [
