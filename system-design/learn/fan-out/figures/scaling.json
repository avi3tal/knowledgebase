    },
    {
     "from": "api",
     "to": "inbox"
    }
   ],
   "steps": [
    {
     "text": "Events go to a log, and workers copy each event id into every watcher's inbox off the request path.",
     "nodes": [
      "repo",
      "log",
      "fan",
      "inbox"
     ],
     "edges": [
      "repo>log",
      "log>fan",
      "fan>inbox"
     ]
    },
    {
     "text": "An open is one read of a ready list, whatever the number of watched repos.",
     "nodes": [
      "u",
      "api",
      "inbox"
     ],
     "edges": [
      "u>api",
      "api>inbox"
     ]
    },
    {
     "text": "Cost: writes grow with watchers. One event on a repo with 300 000 watchers is 300 000 writes, and the workers lag for everyone behind it.",
     "nodes": [
      "fan",
      "inbox"
     ],
     "edges": [
      "fan>inbox"
     ]
    }
   ]
  },
  {
   "name": "v3: hybrid",
