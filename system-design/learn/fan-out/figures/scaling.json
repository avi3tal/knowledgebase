     "kind": "worker",
     "label": "Fan-out workers",
     "x": 540,
     "y": 40
    },
    {
     "id": "inbox",
     "kind": "nosql",
     "label": "Inbox store",
     "x": 540,
     "y": 200
    },
    {
     "id": "api",
     "kind": "service",
     "label": "Inbox API",
     "x": 270,
     "y": 200
    },
