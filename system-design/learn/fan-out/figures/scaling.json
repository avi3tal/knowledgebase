     "label": "Fan-out (EU)",
     "x": 280,
     "y": 40
    },
    {
     "id": "fb",
     "kind": "worker",
     "label": "Fan-out (US)",
     "x": 280,
     "y": 280
    },
    {
     "id": "s1",
     "kind": "nosql",
     "label": "Inbox shard A",
     "sub": "EU users",
     "x": 560,
     "y": 0
    },
    {
     "id": "s2",
