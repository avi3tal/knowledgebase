 "steps": [
  {
   "text": "A user sends a message over their WebSocket; the gateway hands it to the stateless message service.",
   "nodes": [
    "users",
    "gw",
    "msg"
   ],
   "edges": [
    "users>gw",
    "gw>msg"
   ]
  },
  {
   "text": "The service inserts into messages_by_conversation, partitioned by conversation and sorted by a time-based message id. The token-aware driver sends it straight to a replica, node B, which coordinates.",
   "nodes": [
    "msg",
    "n2"
   ],
   "edges": [
    "msg>n2"
   ]
  },
  {
   "text": "B appends to its commit log and memtable and forwards to the other two local replicas. With 2 of 3 acks (LOCAL_QUORUM) it answers: a few milliseconds.",
   "nodes": [
    "n1",
    "n2",
    "n3"
   ],
   "edges": [
    "n2>n1",
    "n2>n3"
   ]
  },
  {
   "text": "The same mutation goes to the other region's DC and to the analytics DC asynchronously; the sender never waits for an ocean crossing.",
   "nodes": [
    "dc2",
    "ana"
   ],
   "edges": [
    "n2>dc2",
    "n2>ana"
   ]
  },
  {
   "text": "The service publishes the new message for fan-out. Push workers deliver it through the gateway to online members, or via APNs / FCM to offline ones.",
   "nodes": [
    "q",
    "push",
    "gw",
    "apns"
   ],
   "edges": [
    "msg>q",
    "q>push",
    "push>gw",
    "push>apns"
   ]
  },
  {
   "text": "Opening a chat reads one partition (the latest 50 messages) at LOCAL_QUORUM. Spark jobs scan only the analytics DC, so heavy reads never touch serving nodes.",
   "nodes": [
    "msg",
    "n2",
    "ana",
    "spark"
   ],
   "edges": [
    "msg>n2",
    "ana>spark"
   ]
  }
 ],
 "scenarios": [
  {
   "name": "New Year's Eve spike",
   "tone": "edge",
   "summary": "Writes are appends, so they stay fast at several times normal load; the bill comes later as compaction debt and slower reads.",
   "steps": [
    {
     "text": "At midnight, message volume jumps to several times its normal peak within a minute.",
     "nodes": [
      "users",
      "gw",
      "msg"
     ],
     "edges": [
      "users>gw",
      "gw>msg"
     ]
    },
    {
     "text": "Each write is still a commit-log append plus a memtable insert, so write latency barely moves.",
     "nodes": [
      "n1",
      "n2",
      "n3"
     ],
     "edges": [
      "msg>n2",
      "n2>n1",
      "n2>n3"
     ]
    },
    {
     "text": "Memtables flush more often and compaction falls behind; reads touch more SSTables and p99 read latency rises.",
     "nodes": [
      "n2"
     ],
     "edges": [
      "msg>n2"
     ]
    },
    {
     "text": "The fan-out queue absorbs the burst; push workers scale out and catch up within minutes.",
     "nodes": [
      "q",
      "push"
     ],
     "edges": [
      "msg>q",
      "q>push"
     ]
    },
    {
     "text": "Size the ring for the peak replicated write rate, and keep disk and CPU headroom for compaction to catch up.",
     "nodes": [
      "n1",
      "n2",
      "n3"
     ]
    }
   ]
  },
  {
   "name": "Node A goes down",
   "tone": "failure",
   "summary": "With RF 3, LOCAL_QUORUM still gets 2 acks from B and C; A catches up from hints and repair when it returns.",
   "steps": [
    {
     "text": "Node A crashes. Gossip marks it down within seconds.",
     "fail": [
      "n1",
      "n2>n1"
     ],
     "nodes": [
      "n2",
      "n3"
     ]
    },
    {
     "text": "B still coordinates: it writes itself and C, gets 2 acks and answers. Senders notice nothing.",
     "fail": [
      "n1"
     ],
     "nodes": [
      "msg",
      "n2",
      "n3"
     ],
     "edges": [
      "msg>n2",
      "n2>n3"
     ]
    },
    {
     "text": "B keeps a hint for every write A missed, for up to 3 hours.",
     "fail": [
      "n1"
     ],
     "nodes": [
      "n2"
     ]
    },
    {
     "text": "A restarts; B replays the hints. A longer outage needs a full repair before A serves reads again.",
     "nodes": [
      "n1",
      "n2"
     ],
     "edges": [
      "n2>n1"
     ]
    }
   ]
  },
