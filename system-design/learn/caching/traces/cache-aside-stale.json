{
 "version": 1,
 "title": "Cache-aside without invalidation — counting stale reads",
 "code": [
  "def cache_aside(db: dict[str, int], ops: list[str], invalidate: bool) -> int:",
  "    db = dict(db)  # work on a copy so the input is left unchanged",
  "    cache: dict[str, int] = {}",
  "    stale = 0",
  "    for i in range(len(ops)):",
  "        kind, rest = ops[i].split(\":\")",
  "        if kind == \"w\":",
  "            key, value = rest.split(\"=\")",
  "            db[key] = int(value)",
  "            if invalidate:",
  "                cache.pop(key, None)",
  "            continue",
  "        key = rest",
  "        if key not in cache:",
  "            cache[key] = db[key]",
  "        answer = cache[key]",
  "        if answer != db[key]:",
  "            stale += 1",
  "    return stale"
 ],
