{
 "version": 1,
 "title": "LRU cache of size 3 — hits, misses and evictions",
 "code": [
  "def lru_hits_misses(requests: list[str], capacity: int) -> list[int]:",
  "    cache: dict[str, str] = {}",
  "    order: list[str] = []  # least recently used first, most recent last",
  "    hits, misses = 0, 0",
  "    for i in range(len(requests)):",
  "        key = requests[i]",
  "        if key in cache:",
  "            hits += 1",
  "            order.remove(key)",
  "            order.append(key)",
  "            continue",
  "        misses += 1",
  "        if len(cache) == capacity:",
  "            victim = order.pop(0)",
  "            del cache[victim]",
  "        cache[key] = \"row:\" + key",
  "        order.append(key)",
  "    return [hits, misses]"
 ],
