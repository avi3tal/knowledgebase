   "steps": [
    {
     "text": "PgBouncer multiplexes thousands of API connections onto a few hundred backends.",
     "nodes": [
      "api",
      "pgb",
      "pri"
     ],
     "edges": [
      "api>pgb",
      "pgb>pri"
     ]
    },
    {
     "text": "A sync standby plus automatic failover: losing the primary costs seconds of errors, not payments.",
     "nodes": [
      "pri",
      "sb"
     ],
     "edges": [
      "pri>sb"
     ]
    },
    {
     "text": "Reports and dashboards move to async replicas; the WAL archive gives point-in-time recovery to any second.",
     "nodes": [
      "rep",
      "ar"
     ],
     "edges": [
      "pgb>rep",
      "pri>rep",
      "pri>ar"
     ]
    },
    {
     "text": "Cost: replicas lag, so read-your-own-write goes to the primary. Writes still have one home, and the ledger table keeps growing.",
     "nodes": [
      "pri"
     ],
     "edges": [
      "pgb>pri"
     ]
    }
   ]
  },
  {
