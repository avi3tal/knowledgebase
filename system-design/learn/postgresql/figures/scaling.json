   "steps": [
    {
     "text": "Postings go to the current month's partition. Its indexes are small enough to stay in memory, and queries filtered by date skip the other months (partition pruning).",
     "nodes": [
      "pri",
      "p3"
     ],
     "edges": [
      "pgb>pri",
      "pri>p3"
     ]
    },
    {
     "text": "Vacuum and index maintenance work one partition at a time, and closed months hardly change.",
     "nodes": [
      "p1",
      "p2"
     ],
     "edges": [
      "pri>p1",
      "pri>p2"
     ]
    },
    {
     "text": "Cost: a unique key must include the partition column, queries without a date scan every month, and next month's partition must exist before the 1st.",
     "nodes": [
      "p1",
      "cold"
     ],
     "edges": [
      "p1>cold"
     ]
    }
