 "steps": [
  {
   "text": "One instance holds every tenant's invoices and ledger: full ACID, every report is one SQL query away, and plenty for the first hundreds of tenants.",
   "nodes": [
    "pg"
   ],
   "edges": [
    "api>pg"
   ]
  },
  {
   "text": "But one machine is a single point of failure, a nightly dump can lose a day of payments, and reports compete with postings for the same CPU.",
   "nodes": [
    "pg",
    "bk"
   ],
   "edges": [
    "pg>bk"
   ]
  }
 ],
