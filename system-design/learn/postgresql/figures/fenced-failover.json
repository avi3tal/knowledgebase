 "steps": [
  {
   "text": "Each database node runs an HA agent. Node A's agent holds the leader key in the consensus store and renews it every 10 s; without renewal the key expires after 30 s.",
   "nodes": [
    "na",
    "dcs"
   ],
   "edges": [
    "na>dcs"
   ]
  },
  {
   "text": "Only the key holder accepts writes. PgBouncer is pointed at whoever holds it, so the API never needs to know which node is primary.",
   "nodes": [
    "api",
    "pgb",
    "na",
    "dcs"
   ],
   "edges": [
    "dcs>pgb",
    "api>pgb",
    "pgb>na"
   ]
  },
  {
   "text": "Node B is the sync standby: every commit waited for it, so it holds every confirmed payment.",
   "nodes": [
    "na",
    "nb"
   ],
   "edges": [
    "na>nb"
   ]
  },
  {
   "text": "Node B's agent watches the key. It may take over only if the key expires and its WAL position is up to date.",
   "nodes": [
    "nb",
    "dcs"
   ],
   "edges": [
    "nb>dcs"
   ]
  }
 ],
