    },
    {
     "text": "Nobody renews the key, and after the 30 s TTL it expires.",
     "nodes": [
      "dcs"
     ],
     "fail": [
      "na",
      "na>dcs"
     ]
    },
    {
     "text": "Node B's agent checks it is caught up, takes the key with an atomic compare-and-set, and promotes its PostgreSQL to primary on a new timeline.",
     "nodes": [
      "nb",
      "dcs"
     ],
     "edges": [
      "nb>dcs"
     ],
     "fail": [
      "na"
     ]
