 "steps": [
  {
   "text": "The pooler sends every write to whoever holds the leader lock.",
   "nodes": [
    "pool",
    "pri"
   ],
   "edges": [
    "pool>pri",
    "ha>pool"
   ]
  },
  {
   "text": "Each commit waits for the sync standby, so the standby always has every confirmed transaction.",
   "nodes": [
    "pri",
    "sb"
   ],
   "edges": [
    "pri>sb"
   ]
  },
  {
   "text": "The async replica and the archive also get the WAL, without slowing commits.",
   "nodes": [
    "rep",
    "wal"
   ],
   "edges": [
    "pri>rep",
    "pri>wal"
   ]
  },
  {
   "text": "The primary's agent renews a 30 s leader lock every 10 s. Losing the lock means: stop accepting writes.",
   "nodes": [
    "ha",
    "pri"
   ],
   "edges": [
    "ha>pri"
   ]
  }
 ],
