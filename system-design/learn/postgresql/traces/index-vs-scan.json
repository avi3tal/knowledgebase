{
 "version": 1,
 "title": "Find key 42: sequential scan of 4 heap pages vs a sorted index",
 "code": [
  "def index_vs_scan(pages: list[list[int]], index: list[list[int]], target: int) -> list[int]:",
  "    pages_read = 0",
  "    page_found = -1",
  "    for p in range(len(pages)):",
  "        pages_read += 1",
  "        for r in range(len(pages[p])):",
  "            if pages[p][r] == target:",
  "                page_found = p",
  "    probes = 0",
  "    lo = 0",
  "    hi = len(index) - 1",
  "    while lo <= hi:",
  "        mid = (lo + hi) // 2",
  "        probes += 1",
  "        if index[mid][0] == target:",
  "            page_found = index[mid][1]",
  "            break",
  "        if index[mid][0] < target:",
  "            lo = mid + 1",
  "        else:",
  "            hi = mid - 1",
  "    return [pages_read, probes, page_found]"
 ],
