{
 "version": 1,
 "title": "MVCC: T2 keeps its snapshot while T3 updates a and T4 sees the new version",
 "code": [
  "def mvcc(rows: dict[str, int], ops: list[str]) -> list[str]:",
  "    versions: list[list] = []",
  "    for key in rows:",
  "        versions.append([key, rows[key], 1, 0])",
  "    committed = {1: True}",
  "    snaps: dict[int, dict[int, bool]] = {}",
  "    reads: list[str] = []",
  "    for i in range(len(ops)):",
  "        parts = ops[i].split(\":\")",
  "        tx = int(parts[0])",
  "        if parts[1] == \"begin\":",
  "            snaps[tx] = dict(committed)",
  "            continue",
  "        if parts[1] == \"commit\":",
  "            committed[tx] = True",
  "            continue",
  "        key = parts[2].split(\"=\")[0]",
  "        snap = snaps[tx]",
  "        seen = -1",
  "        for j in range(len(versions)):",
  "            v = versions[j]",
  "            born = v[0] == key and (v[2] == tx or v[2] in snap)",
  "            dead = v[3] == tx or v[3] in snap",
  "            if born and not dead:",
  "                seen = j",
  "        if parts[1] == \"get\":",
  "            reads.append(f\"{tx}:{key}={versions[seen][1]}\")",
  "            continue",
  "        value = int(parts[2].split(\"=\")[1])",
  "        versions[seen][3] = tx",
  "        versions.append([key, value, tx, 0])",
  "    return reads"
 ],
