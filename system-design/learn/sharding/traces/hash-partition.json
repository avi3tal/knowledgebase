{
 "version": 1,
 "title": "Hash partitioning — crc32(key) % 3",
 "code": [
  "def partition(keys: list[str], mode: str, shards: int, boundaries: list[str]) -> list[int]:",
  "    placement: dict[str, int] = {}",
  "    counts = [0] * shards",
  "    for i in range(len(keys)):",
  "        key = keys[i]",
  "        if mode == \"range\":",
  "            shard = bisect_right(",
  "                boundaries, key",
  "            )",
  "        else:",
  "            shard = (",
  "                stable_hash(key) % shards",
  "            )",
  "        placement[key] = shard",
  "        counts[shard] += 1",
  "    return counts"
 ],
