    },
    {
     "from": "aus",
     "to": "sus"
    }
   ],
   "steps": [
    {
     "text": "A small global directory maps each tenant to its home region; DNS or the edge sends users there.",
     "nodes": [
      "dir",
      "aeu",
      "aus"
     ],
     "edges": [
      "dir>aeu",
      "dir>aus"
     ]
    },
    {
     "text": "Each region runs its own app servers, router and shards, so queries never cross an ocean.",
     "nodes": [
      "ueu",
      "uus",
      "aeu",
      "aus",
      "seu",
      "sus"
     ],
     "edges": [
      "ueu>aeu",
      "uus>aus",
      "aeu>seu",
      "aus>sus"
     ]
    },
    {
     "text": "EU tenants' data stays in the EU, which is often a contract requirement.",
     "nodes": [
      "seu"
     ],
     "edges": [
      "aeu>seu"
     ]
    },
    {
     "text": "Cost: moving a tenant between regions is a slow, planned migration, and the directory must be highly available.",
