     "x": 280,
     "y": 0
    },
    {
     "id": "aus",
     "kind": "service",
     "label": "US app + router",
     "x": 280,
     "y": 270
    },
    {
     "id": "seu",
     "kind": "sql",
     "label": "EU shards 1–8",
     "x": 560,
     "y": 0
    },
    {
     "id": "sus",
