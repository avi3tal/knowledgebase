     "label": "US shards 1–12",
     "x": 560,
     "y": 270
    }
   ],
   "edges": [
    {
     "from": "ueu",
     "to": "aeu"
    },
    {
     "from": "uus",
     "to": "aus"
    },
    {
     "from": "dir",
