{
 "kind": "architecture",
 "title": "Scaling the database: from one Postgres to sharded, then regional shards",
 "caption": "Each stage removes the bottleneck of the previous one; switch the 📈 tabs to grow the system.",
 "base_name": "v1: one database",
 "nodes": [
  {
   "id": "app",
   "kind": "service",
   "label": "App servers",
   "x": 0,
   "y": 135
  },
  {
   "id": "db",
   "kind": "sql",
   "label": "Postgres",
   "sub": "one primary",
   "x": 280,
   "y": 135
  }
 ],
 "edges": [
  {
   "from": "app",
   "to": "db",
   "label": "all reads + writes"
  }
 ],
 "steps": [
  {
   "text": "One primary holds every tenant: joins, transactions and ad-hoc queries just work.",
   "nodes": [
    "app",
    "db"
   ],
   "edges": [
    "app>db"
   ]
  },
  {
   "text": "It hits its limit on whichever comes first: read CPU, write IOPS, or a dataset that no longer fits in memory.",
   "nodes": [
    "db"
   ],
   "edges": [
    "app>db"
   ]
  }
 ],
 "scenarios": [
  {
   "name": "v2: read replicas",
   "tone": "scale",
   "summary": "Replicas take the reads off the primary. Every write and every byte still lives on one primary.",
   "nodes": [
    {
     "id": "app",
     "kind": "service",
     "label": "App servers",
     "x": 0,
     "y": 135
    },
    {
     "id": "r1",
     "kind": "sql",
     "label": "Replica 1",
     "sub": "reads",
     "x": 280,
     "y": 0
    },
    {
     "id": "p",
     "kind": "sql",
     "label": "Primary",
     "sub": "all writes",
     "x": 280,
     "y": 135
    },
    {
     "id": "r2",
     "kind": "sql",
     "label": "Replica 2",
     "sub": "reads",
     "x": 280,
     "y": 270
    }
   ],
   "edges": [
    {
     "from": "app",
     "to": "p",
     "label": "writes"
    },
    {
     "from": "p",
     "to": "r1",
     "label": "replication"
    },
    {
     "from": "p",
     "to": "r2",
     "label": "replication"
    },
    {
     "from": "app",
     "to": "r1",
     "label": "reads"
    },
    {
     "from": "app",
     "to": "r2"
    }
   ],
   "steps": [
    {
     "text": "Reads spread over replicas; the primary only takes writes.",
     "nodes": [
      "app",
      "r1",
      "r2"
     ],
     "edges": [
      "app>r1",
      "app>r2"
     ]
    },
    {
     "text": "Replicas trail by milliseconds to seconds, so a user may not see their own write. Read those from the primary.",
     "nodes": [
      "p",
      "r1",
      "r2"
     ],
     "edges": [
      "p>r1",
      "p>r2"
     ]
    },
    {
     "text": "Cost: writes and total size are still capped by one machine, and every replica stores everything.",
     "nodes": [
      "p"
     ],
     "edges": [
      "app>p"
     ]
    }
   ]
  },
  {
