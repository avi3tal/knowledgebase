     "label": "Shard map",
     "x": 280,
     "y": 0
    },
    {
     "id": "s1",
     "kind": "sql",
     "label": "Shard 1",
     "sub": "+ replica",
     "x": 560,
     "y": 0
    },
    {
     "id": "s2",
     "kind": "sql",
     "label": "Shard 2",
     "sub": "+ replica",
     "x": 560,
     "y": 135
    },
    {
     "id": "s3",
     "kind": "sql",
     "label": "Shard 3",
     "sub": "+ replica",
     "x": 560,
     "y": 270
    }
   ],
   "edges": [
    {
     "from": "app",
     "to": "router"
    },
    {
     "from": "map",
     "to": "router"
    },
    {
     "from": "router",
     "to": "s1"
    },
    {
     "from": "router",
     "to": "s2"
    },
    {
     "from": "router",
     "to": "s3"
    }
   ],
   "steps": [
    {
     "text": "Each tenant lives on one shard; the router reads the shard map to find it.",
     "nodes": [
      "app",
      "router",
      "map"
     ],
     "edges": [
      "app>router",
      "map>router"
     ]
    },
    {
     "text": "Writes and data size now scale with the number of shards; each still has its own replica.",
     "nodes": [
      "s1",
      "s2",
      "s3"
     ],
     "edges": [
      "router>s1",
      "router>s2",
      "router>s3"
     ]
    },
    {
     "text": "Cost: no joins or transactions across tenants, cross-tenant reports need another store, and someone must operate rebalancing.",
