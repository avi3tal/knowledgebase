 "steps": [
  {
   "text": "Every query carries the shard key (here user_id). The router can be a library inside the app or a proxy in front of the shards.",
   "nodes": [
    "app",
    "router"
   ],
   "edges": [
    "app>router"
   ]
  },
  {
   "text": "The router maps key → shard with the shard map: key ranges, hash slots or a lookup table. The map is tiny and cached, so this costs microseconds.",
   "nodes": [
    "router",
    "map"
   ],
   "edges": [
    "router>map"
   ]
  },
  {
   "text": "The query goes to exactly one shard. The other shards never see it, so adding shards adds capacity.",
   "nodes": [
    "router",
    "s1"
   ],
   "edges": [
    "router>s1"
   ]
  },
  {
   "text": "Each shard holds a disjoint slice of the rows and has its own replicas. Shards share nothing, which is the point and also the problem: no joins or transactions across them.",
   "nodes": [
    "s0",
    "s1",
    "s2"
   ],
   "edges": []
  }
 ],
