 "steps": [
  {
   "text": "A query arrives from an app server with tenant 812's id attached.",
   "nodes": [
    "in",
    "tid"
   ],
   "edges": [
    "in>tid"
   ]
  },
  {
   "text": "It has a tenant_id, so it belongs to exactly one shard.",
   "nodes": [
    "has"
   ],
   "edges": [
    "tid>has",
    "has>hit"
   ]
  },
  {
   "text": "The router's in-memory map already has tenant 812.",
   "nodes": [
    "hit",
    "look"
   ],
   "edges": [
    "hit>look"
   ]
  },
  {
   "text": "map[812] = shard 2, at map version 17.",
   "nodes": [
    "look",
    "q"
   ],
   "edges": [
    "look>q"
   ]
  },
  {
   "text": "Shard 2 checks that it owns tenant 812 at version 17 and runs the query.",
   "nodes": [
    "own"
   ],
   "edges": [
    "q>own"
   ]
  },
  {
   "text": "Rows come back. Total routing overhead: microseconds.",
   "nodes": [
    "ok"
   ],
   "edges": [
    "own>ok"
   ]
  }
 ],
 "scenarios": [
  {
