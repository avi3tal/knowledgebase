   "steps": [
    {
     "text": "A new enterprise tenant lands on shard 2 and imports five years of history, then runs heavy daily usage.",
     "nodes": [
      "users",
      "app",
      "router",
      "s2"
     ],
     "edges": [
      "users>lb",
      "lb>app",
      "app>router",
      "router>s2"
     ]
    },
    {
     "text": "Shard 2's write latency and disk climb while shards 1 and 3 are idle. Metrics flag it.",
     "nodes": [
      "s2",
      "mon",
      "rebal"
     ],
     "edges": [
      "mon>rebal"
     ]
    },
    {
     "text": "The rebalancer moves a batch of small tenants from shard 2 to shard 3, one tenant at a time.",
     "nodes": [
      "rebal",
      "s2",
      "s3"
     ],
     "edges": [
      "s2>s3"
     ]
    },
    {
     "text": "Each move ends with a map flip; routers pick it up and the big tenant has shard 2 nearly to itself.",
     "nodes": [
      "map",
      "router"
     ],
     "edges": [
      "rebal>map",
      "map>router"
     ]
    }
   ]
  },
  {
   "name": "Shard 2 primary fails",
   "tone": "failure",
   "summary": "Sharding limits the blast radius: only tenants on shard 2 see errors, and only until its replica is promoted.",
   "steps": [
    {
     "text": "Shard 2's primary dies. Writes for its tenants fail; tenants on shards 1 and 3 notice nothing.",
     "fail": [
      "s2",
      "router>s2"
     ],
     "nodes": [
      "router",
      "s1",
      "s3"
     ],
     "edges": [
      "router>s1",
      "router>s3"
     ]
    },
    {
     "text": "Failover promotes shard 2's replica within about 30 seconds. The map still says shard 2: only its address changes.",
     "fail": [
      "router>s2"
     ],
     "nodes": [
      "s2"
     ]
    },
    {
     "text": "The router reconnects to the new primary; app servers retry idempotent writes.",
     "nodes": [
      "router",
      "s2"
     ],
     "edges": [
      "router>s2",
      "app>router"
     ]
    },
    {
     "text": "Writes acknowledged by the old primary but not yet replicated may be lost. Alert, and say so in the interview.",
     "nodes": [
      "mon"
     ],
     "edges": [
      "mon>rebal"
     ]
    }
   ]
  },
