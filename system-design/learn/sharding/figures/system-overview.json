 "steps": [
  {
   "text": "A user of tenant 812 (a 300-person company on a project-tracking SaaS) loads their board. Any app server can take the request.",
   "nodes": [
    "users",
    "lb",
    "app"
   ],
   "edges": [
    "users>lb",
    "lb>app"
   ]
  },
  {
   "text": "The app server reads tenant_id from the auth token. Small global data (plans, billing, the tenant list) lives in one unsharded Accounts DB.",
   "nodes": [
    "app",
    "acct"
   ],
   "edges": [
    "app>acct"
   ]
  },
  {
   "text": "Tenant data goes through the shard router with the tenant_id attached. The router keeps the shard map in memory and watches the map store for changes.",
   "nodes": [
    "app",
    "router",
    "map"
   ],
   "edges": [
    "app>router",
    "map>router"
   ]
  },
  {
   "text": "The map says tenant 812 lives on shard 2. The query runs there and only there: one tenant's rows never span shards, so joins and transactions still work.",
   "nodes": [
    "router",
    "s2"
   ],
   "edges": [
    "router>s2"
   ]
  },
  {
   "text": "Each shard is an ordinary primary with a replica. Writes go to the primary; dashboards that tolerate a second of lag read the replica.",
   "nodes": [
    "s1",
    "s2",
    "s3"
   ],
   "edges": [
    "router>s1",
    "router>s2",
    "router>s3"
   ]
  },
  {
   "text": "Per-shard size, QPS and p99 latency feed the rebalancer. It moves tenants by copying their rows and then flipping one map entry.",
   "nodes": [
    "mon",
    "rebal",
    "map"
   ],
   "edges": [
    "mon>rebal",
    "rebal>map"
   ]
  }
 ],
