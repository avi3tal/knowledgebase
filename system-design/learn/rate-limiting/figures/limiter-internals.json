 "steps": [
  {
   "text": "Find the rule for this caller and route in the in-memory rule table (tier, endpoint, method).",
   "nodes": [
    "in",
    "rule"
   ],
   "edges": [
    "in>rule"
   ]
  },
  {
   "text": "A rule applies.",
   "nodes": [
    "has"
   ],
   "edges": [
    "rule>has",
    "has>key"
   ]
  },
  {
   "text": "Build the counter key from what the rule limits by: api_key:POST /orders, or ip for anonymous calls.",
   "nodes": [
    "key"
   ],
   "edges": [
    "has>key"
   ]
  },
  {
   "text": "One atomic operation increments (or takes a token) and returns the new value.",
   "nodes": [
    "incr",
    "over"
   ],
   "edges": [
    "key>incr",
    "incr>over"
   ]
  },
  {
   "text": "Under the limit: forward, and add X-RateLimit-Remaining so clients can pace themselves.",
   "nodes": [
    "ok"
   ],
   "edges": [
    "over>ok"
   ]
  }
 ],
 "scenarios": [
  {
   "name": "Over the limit",
   "tone": "edge",
   "summary": "The same path ends in a cheap rejection with Retry-After.",
   "steps": [
    {
     "text": "Same lookup and key.",
