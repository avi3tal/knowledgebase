 "steps": [
  {
   "text": "The uploader asks the API for a URL; the API records a pending row.",
   "nodes": [
    "up",
    "api",
    "meta"
   ],
   "edges": [
    "up>api",
    "api>meta"
   ]
  },
  {
   "text": "The uploader PUTs the bytes straight to the store with the presigned URL.",
   "nodes": [
    "up",
    "store"
   ],
   "edges": [
    "up>store"
   ]
  },
  {
   "text": "ObjectCreated lands on a queue; transcoders read the raw file, write each rendition back to the store, and mark the row ready.",
   "nodes": [
    "store",
    "q",
    "w",
    "meta"
   ],
   "edges": [
    "store>q",
    "q>w",
    "w>meta"
   ]
  },
  {
   "text": "Viewers read through the CDN. Only misses reach the store, so a video watched 1M times is fetched from the origin about once per edge.",
   "nodes": [
