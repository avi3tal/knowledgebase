    "pl>api",
    "api>b",
    "pl>b"
   ]
  },
  {
   "text": "Fine for an internal test team. For players, every patch is a full 60 GB download from one region, and egress straight from the bucket is the most expensive way to serve it.",
   "nodes": [
    "pl",
    "b"
   ],
   "edges": [
    "pl>b"
   ]
  }
 ],
 "scenarios": [
