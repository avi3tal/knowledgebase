     "edges": [
      "c>api",
      "api>hot"
     ]
    },
    {
     "text": "Lifecycle rules move bytes by age: hot, then infrequent (cheaper per GB, a fee per read), then archive (cheapest, hours to restore).",
     "nodes": [
      "hot",
      "ia",
      "arc"
     ],
     "edges": [
      "hot>ia",
      "ia>arc"
