 "steps": [
  {
   "text": "Hash each part's bytes; the hash is the part's key.",
   "nodes": [
    "in",
    "hash",
    "have"
   ],
   "edges": [
    "in>hash",
    "hash>have"
   ]
  },
  {
   "text": "New content: upload it. This is the only case that costs bandwidth.",
   "nodes": [
    "put"
   ],
   "edges": [
    "have>put"
   ]
  },
  {
