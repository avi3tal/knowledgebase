 "steps": [
  {
   "text": "An hour before release, release control sets live = 2.3.0 behind a flag, and the pre-warm job requests every new chunk through the shield so it holds them before the doors open.",
   "nodes": [
    "rel",
    "mdb",
    "pw",
    "sh"
   ],
   "edges": [
    "rel>mdb",
    "pw>sh"
   ]
  },
  {
   "text": "At 17:00 the flag flips. Launchers ask for the live manifest; the pointer is cached for 60 s and each manifest forever, so the database sees a trickle.",
   "nodes": [
    "pl",
    "api",
    "mc",
    "mdb"
   ],
   "edges": [
    "pl>api",
    "api>mc",
    "mc>mdb"
   ]
  },
  {
   "text": "Each launcher diffs manifests and requests only the chunks it lacks, by hash, from its nearest edge, several in parallel and with byte ranges for resumes.",
   "nodes": [
    "pl",
    "e1",
    "e2"
   ],
   "edges": [
    "pl>e1",
    "pl>e2"
   ]
  },
  {
   "text": "Edge misses go to the shield, not the bucket. Concurrent misses for one chunk wait on a single fetch.",
   "nodes": [
    "e1",
    "e2",
    "sh"
   ],
   "edges": [
    "e1>sh",
    "e2>sh"
   ]
  },
  {
   "text": "The bucket serves each new chunk about once per shield, however many players there are; after that, every request ends at an edge.",
   "nodes": [
    "sh",
    "b"
   ],
   "edges": [
    "sh>b"
   ]
  }
 ],
