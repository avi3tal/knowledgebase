{
 "version": 1,
 "title": "Multipart upload — 6 parts, out of order, one retry",
 "code": [
  "def multipart_upload(data: str, part_size: int, arrivals: list[int]) -> list:",
  "    parts: list[str] = []",
  "    for start in range(0, len(data), part_size):",
  "        piece = data[start : start + part_size]",
  "        parts.append(piece)",
  "    received: dict[int, str] = {}",
  "    for i in range(len(arrivals)):",
  "        number = arrivals[i]",
  "        received[number] = parts[number - 1]",
  "    assembled = \"\"",
  "    for number in range(1, len(parts) + 1):",
  "        if number not in received:",
  "            return [len(parts), \"missing:\" + str(number)]",
  "        assembled += received[number]",
  "    return [len(parts), assembled]"
 ],
 "view": [
  {
   "id": "parts",
   "type": "array",
   "var": "parts",
   "label": "parts on the client (part 1 first)"
  },
  {
   "id": "arrivals",
   "type": "array",
   "var": "arrivals",
   "label": "part numbers in arrival order",
   "pointers": {
    "now": "i"
   }
  },
  {
   "id": "received",
   "type": "map",
   "var": "received",
   "label": "parts held by the store"
  },
  {
   "id": "vars",
   "type": "vars",
   "vars": [
    "number",
    "assembled"
   ]
  }
 ],
