{
 "version": 1,
 "title": "Content-addressed parts — three files, four stored parts",
 "code": [
  "def dedup_parts(files: dict[str, str], part_size: int) -> list[int]:",
  "    store: dict[str, str] = {}",
  "    manifests: dict[str, list[str]] = {}",
  "    referenced = 0",
  "    for name in files:",
  "        data = files[name]",
  "        manifests[name] = []",
  "        for start in range(0, len(data), part_size):",
  "            part = data[start : start + part_size]",
  "            key = hashlib.sha256(part.encode()).hexdigest()[:8]",
  "            referenced += 1",
  "            if key not in store:",
  "                store[key] = part",
  "            manifests[name].append(key)",
  "    return [referenced, len(store)]"
 ],
 "view": [
  {
   "id": "store",
   "type": "map",
   "var": "store",
   "label": "object store (hash → bytes)"
  },
  {
   "id": "manifests",
   "type": "map",
   "var": "manifests",
   "label": "manifests (file → part hashes)"
  },
  {
   "id": "vars",
   "type": "vars",
   "vars": [
    "name",
    "part",
    "key",
    "referenced"
   ]
  }
 ],
