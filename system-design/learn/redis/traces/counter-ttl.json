{
 "version": 1,
 "title": "INCR + EXPIRE: per-user counters that reset when the TTL passes",
 "code": [
  "def counter_ttl(requests: list[str], limit: int, ttl: int) -> list[int]:",
  "    store: dict[str, int] = {}",
  "    expires_at: dict[str, int] = {}",
  "    allowed, rejected = 0, 0",
  "    for i in range(len(requests)):",
  "        second, user = requests[i].split(\":\")",
  "        now = int(second)",
  "        key = \"hits:\" + user",
  "        if key in expires_at and now >= expires_at[key]:",
  "            del store[key]",
  "            del expires_at[key]",
  "        count = store.get(key, 0) + 1",
  "        store[key] = count",
  "        if count == 1:",
  "            expires_at[key] = now + ttl",
  "        if count <= limit:",
  "            allowed += 1",
  "        else:",
  "            rejected += 1",
  "    return [allowed, rejected]"
 ],
