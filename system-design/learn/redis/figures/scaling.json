 "steps": [
  {
   "text": "One Redis node holds sessions, counters and boards: about 100k simple ops/s with sub-millisecond latency.",
   "nodes": [
    "app",
    "r"
   ],
   "edges": [
    "app>r"
   ]
  },
  {
   "text": "Limits: one machine's RAM, one CPU core for commands, and no failover. If it dies, everything in it is gone until it restarts from its last snapshot.",
   "nodes": [
