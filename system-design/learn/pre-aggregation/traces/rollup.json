{
 "version": 1,
 "title": "Minute → hour rollup — sum and count, not average",
 "code": [
  "def rollup(minutes: list[list[int]]) -> list[int]:",
  "    hours: dict[int, list[int]] = {}",
  "    minute_avgs: list[int] = []",
  "    for i in range(len(minutes)):",
  "        minute, total, count = minutes[i][0], minutes[i][1], minutes[i][2]",
  "        hour = minute // 60",
  "        if hour not in hours:",
  "            hours[hour] = [0, 0]",
  "        hours[hour][0] += total",
  "        hours[hour][1] += count",
  "        if hour == 0:",
  "            minute_avgs.append(total // count)",
  "    first = hours[0]",
  "    exact = first[0] // first[1]",
  "    total_of_avgs = sum(minute_avgs)",
  "    naive = total_of_avgs // len(minute_avgs)",
  "    return [exact, naive]"
 ],
 "view": [
