   "steps": [
    {
     "text": "Consumers stopped keeping up because a group can't have more active members than partitions. Grow orders from 6 to 48 partitions and add brokers to hold them.",
     "nodes": [
      "p",
      "t"
     ],
     "edges": [
      "p>t"
     ]
    },
    {
     "text": "Each group now scales independently up to 48 members.",
     "nodes": [
      "g1",
      "g2",
      "g3"
     ],
     "edges": [
      "t>g1",
      "t>g2",
      "t>g3"
     ]
    },
    {
     "text": "Cost: adding partitions changes hash(key) % N, so a key's new records land on a different partition than its old ones (plan it, or create a new topic). Partitions can't be removed, and more of them mean longer failovers and rebalances.",
     "nodes": [
      "t"
     ],
     "edges": [
      "p>t"
     ]
    }
