 "steps": [
  {
   "text": "Will you ever reprocess old events (bug fix, backfill, new index)? Only a retained log can do that.",
   "nodes": [
    "in",
    "replay",
    "kafka"
   ],
   "edges": [
    "in>replay",
    "replay>kafka"
   ]
  },
  {
   "text": "Will several independent services read the same events, or do you need per-key order at high volume? A log serves every group for the cost of one write.",
   "nodes": [
    "many",
    "kafka"
   ],
   "edges": [
    "replay>many",
    "many>kafka"
   ]
  },
  {
   "text": "Do individual jobs need retries, delays, priorities or a DLQ? Kafka has none of these per record. Use SQS, RabbitMQ or a job framework.",
   "nodes": [
    "retry",
    "tq"
   ],
   "edges": [
    "many>retry",
    "retry>tq"
   ]
  },
  {
   "text": "None of the above: either works, so choose the one your team already runs.",
   "nodes": [
    "either"
   ],
   "edges": [
    "retry>either"
   ]
  }
