      "type": "trace",
      "id": "partition-by-key",
      "title": "Partitioning by key — 7 events into 3 partitions",
      "source": "examples/partition_by_key.py",
      "function": "partition_by_key",
      "input": {
        "events": [
          ["u1", "login"],
          ["u2", "view"],
          ["u3", "cart"],
          ["u1", "view"],
          ["u4", "login"],
          ["u2", "buy"],
          ["u1", "logout"]
        ],
        "partitions": 3
      },
      "view": [
        {
          "id": "events",
          "type": "array",
          "var": "events",
          "label": "events produced (key, value)"
        },
        {
          "id": "logs",
          "type": "grid",
          "var": "logs",
          "label": "partitions p0..p2 (offset →)",
          "cells": {
            "append": ["p", "offset"]
          }
        },
        {
          "id": "vars",
          "type": "vars",
          "vars": ["key", "h", "p", "offset"]
        }
      ],
      "checks": [
        {
          "input": {
            "events": [
              ["u1", "login"],
              ["u2", "view"],
              ["u3", "cart"],
              ["u1", "view"],
              ["u4", "login"],
              ["u2", "buy"],
              ["u1", "logout"]
            ],
            "partitions": 3
          },
          "expected": [["u3:cart"], ["u1:login", "u1:view", "u4:login", "u1:logout"], ["u2:view", "u2:buy"]]
        },
        {
          "input": {
            "events": [
              ["a", "x"],
              ["a", "y"]
            ],
            "partitions": 2
          },
          "expected": [[], ["a:x", "a:y"]]
        },
        {
          "input": {
            "events": [
              ["k1", "1"],
              ["k2", "2"]
            ],
            "partitions": 1
          },
          "expected": [["k1:1", "k2:2"]]
        }
      ]
    },
