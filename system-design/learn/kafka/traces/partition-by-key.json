{
 "version": 1,
 "title": "Partitioning by key — 7 events into 3 partitions",
 "code": [
  "def partition_by_key(events: list[list[str]], partitions: int) -> list[list[str]]:",
  "    logs: list[list[str]] = []",
  "    for _ in range(partitions):",
  "        logs.append([])",
  "    p, offset = None, None",
  "    for key, value in events:",
  "        h = 0",
  "        for ch in key:",
  "            h += ord(ch)",
  "        p = h % partitions",
  "        offset = len(logs[p])",
  "        logs[p].insert(offset, key + \":\" + value)",
  "    return logs"
 ],
 "view": [
  {
   "id": "events",
   "type": "array",
   "var": "events",
   "label": "events produced (key, value)"
  },
