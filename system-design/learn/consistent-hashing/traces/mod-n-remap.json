{
 "version": 1,
 "title": "Naive hash % N — 3 servers become 4",
 "code": [
  "def mod_n_remap(key_hashes: dict[str, int], n_before: int, n_after: int) -> list[str]:",
  "    owner: dict[str, int] = {}",
  "    for key in key_hashes:",
  "        owner[key] = key_hashes[key] % n_before",
  "    moved: list[str] = []",
  "    for key in key_hashes:",
  "        new_server = key_hashes[key] % n_after",
  "        if new_server != owner[key]:",
  "            moved.append(key)",
  "        owner[key] = new_server",
  "    return moved"
 ],
