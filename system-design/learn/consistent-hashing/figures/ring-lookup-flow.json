 "steps": [
  {
   "text": "Hash the key with the same function used for the servers, so both live in one space.",
   "nodes": [
    "in",
    "hash"
   ],
   "edges": [
    "in>hash"
   ]
  },
  {
   "text": "Binary-search the sorted positions for the first one at or after p. With 10 servers × 150 vnodes that's about 11 comparisons.",
   "nodes": [
    "search",
    "found"
   ],
   "edges": [
    "hash>search",
    "search>found"
   ]
  },
  {
   "text": "Past the last position? Wrap around to the first: that is the 'ring' part.",
   "nodes": [
