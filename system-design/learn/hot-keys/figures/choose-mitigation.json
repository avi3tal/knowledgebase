 "steps": [
  {
   "text": "Only keys the detector flags get special treatment; cold keys keep the plain path.",
   "nodes": [
    "start",
    "reads"
   ],
   "edges": [
    "start>reads"
   ]
  },
  {
   "text": "Hot reads that tolerate a second of lag: cache in-process with a short TTL and coalesce misses.",
   "nodes": [
    "lag",
    "local"
   ],
   "edges": [
    "reads>lag",
    "lag>local"
   ]
  },
  {
   "text": "Hot reads that must be fresher: keep N copies of the key on different shards and update them all on write.",
   "nodes": [
    "replicas"
   ],
   "edges": [
    "lag>replicas"
   ]
  },
  {
   "text": "Hot writes that add up (counts, sums, set adds): split into sub-keys and merge on read.",
   "nodes": [
    "comm",
    "split"
   ],
   "edges": [
    "reads>comm",
    "comm>split"
   ]
  },
  {
   "text": "Writes that must be ordered or exact (current high bid): you can't split. Keep one owner and make each write as small as possible.",
   "nodes": [
    "serial"
   ],
   "edges": [
    "comm>serial"
   ]
  }
 ]
