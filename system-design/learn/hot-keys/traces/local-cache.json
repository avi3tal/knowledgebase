   }
  },
  {
   "id": "local",
   "type": "map",
   "var": "local",
   "label": "local copies → expiry tick"
  },
  {
   "id": "vars",
   "type": "vars",
   "vars": [
    "server",
    "slot",
    "local_hits",
    "shard_reads"
   ]
  }
 ],
