{
 "version": 1,
 "title": "One viral key on 4 shards: hash(key) % 4, no splitting",
 "code": [
  "def shard_load(requests: list[str], hot: str, shards: int, split: int) -> list[int]:",
  "    load = [0] * shards",
  "    hot_seen = 0",
  "    for i in range(len(requests)):",
  "        key = requests[i]",
  "        if key == hot and split > 1:",
  "            key = hot + \"#\" + str(hot_seen % split)",
  "            hot_seen += 1",
  "        shard = shard_of(key, shards)",
  "        load[shard] += 1",
  "    return load"
 ],
