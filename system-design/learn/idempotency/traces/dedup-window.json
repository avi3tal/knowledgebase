{
 "version": 1,
 "title": "Consumer dedup with a 3-id window: m2 is caught, m1 slips through after expiring",
 "code": [
  "def dedup_window(messages: list[str], window: int) -> list[int]:",
  "    seen: dict[str, int] = {}",
  "    handled: dict[str, int] = {}",
  "    processed = 0",
  "    dropped = 0",
  "    slipped = 0",
  "    for i in range(len(messages)):",
  "        msg = messages[i]",
  "        if msg in seen:",
  "            dropped += 1",
  "            continue",
  "        if msg in handled:",
  "            slipped += 1",
  "        processed += 1",
  "        handled[msg] = i",
  "        seen[msg] = i",
  "        if len(seen) > window:",
  "            ids = iter(seen)",
  "            oldest = next(ids)",
  "            del seen[oldest]",
  "    return [processed, dropped, slipped]"
 ],
