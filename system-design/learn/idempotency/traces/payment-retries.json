{
 "version": 1,
 "title": "Payment API with retries: an idempotency-key table turns duplicates into stored responses",
 "code": [
  "def payment_retries(requests: list[str], use_key: bool) -> list[int]:",
  "    keys: dict[str, list] = {}",
  "    ledger: list[str] = []",
  "    replayed = 0",
  "    rejected = 0",
  "    for i in range(len(requests)):",
  "        key, amount = requests[i].split(\":\")",
  "        if use_key and key in keys:",
  "            if keys[key][0] != amount:",
  "                rejected += 1",
  "                continue",
  "            replayed += 1",
  "            response = keys[key][1]",
  "            continue",
  "        ledger.append(f\"{key}:{amount}\")",
  "        response = f\"ch_{len(ledger)}\"",
  "        if use_key:",
  "            keys[key] = [amount, response]",
  "    charges = len(ledger)",
  "    return [charges, replayed, rejected]"
 ],
