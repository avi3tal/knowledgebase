 "steps": [
  {
   "text": "The key table sits in the payments database: claim, payment and stored response commit in one transaction. The strongest guarantee there is.",
   "nodes": [
    "api",
    "db"
   ],
   "edges": [
    "c>api",
    "api>db"
   ]
  },
  {
   "text": "Cost: an extra indexed write per request on the primary, and a cleanup job that deletes millions of rows a day.",
   "nodes": [
    "db",
    "job"
   ],
   "edges": [
    "job>db"
   ]
  }
 ],
 "scenarios": [
  {
