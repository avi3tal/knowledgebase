    }
   ],
   "steps": [
    {
     "text": "Events are keyed by payment_id, so every copy of one event lands on the same partition and the same consumer.",
     "nodes": [
      "pay",
      "st",
      "c1",
      "c2"
     ],
     "edges": [
      "pay>st",
      "st>c1",
      "st>c2"
     ]
    },
    {
     "text": "Each consumer writes its effect and the event id in one transaction; the seen-id table is partitioned by day.",
     "nodes": [
      "c1",
      "c2",
      "pdb"
     ],
     "edges": [
      "c1>pdb",
      "c2>pdb"
     ]
    },
    {
     "text": "Old days are dropped as whole partitions once they are older than the topic's retention (no duplicate can be older than that).",
     "nodes": [
