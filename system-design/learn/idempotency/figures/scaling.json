     "label": "forward to home"
    }
   ],
   "steps": [
    {
     "text": "Users are routed to their home region, and keys are claimed in that region's store at local latency.",
     "nodes": [
      "ue",
      "ae",
      "ke",
      "uu",
      "au",
      "ku"
     ],
     "edges": [
      "ue>ae",
      "uu>au",
      "ae>ke",
      "au>ku"
     ]
    },
    {
     "text": "An EU user's retry that lands in the US (DNS failover, travel) is forwarded to the EU store instead of being claimed locally.",
     "nodes": [
      "au",
      "ae"
     ],
     "edges": [
      "au>ae",
      "ae>ke"
     ]
    },
    {
     "text": "Both regions pass the key on to the processor, a second referee if routing ever goes wrong.",
     "nodes": [
      "psp"
     ],
     "edges": [
      "ae>psp",
      "au>psp"
     ]
    },
    {
     "text": "Cost: +80 ms for forwarded retries, and while a home region is down its users' payments pause rather than risk a double charge.",
     "nodes": [
      "ae",
      "ke"
     ],
     "edges": [
      "au>ae"
     ]
    }
   ]
  },
  {
   "name": "v4: consumer dedup at scale",
   "tone": "scale",
   "summary": "Billions of events a day: partition by payment id so duplicates always meet the same consumer, and bound the dedup window.",
