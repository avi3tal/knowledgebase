    {
     "from": "a2",
     "to": "db"
    }
   ],
   "steps": [
    {
     "text": "Any API instance can take any retry; all of them claim keys in one shared store.",
     "nodes": [
      "lb",
      "a1",
      "a2"
     ],
     "edges": [
      "c>lb",
      "lb>a1",
      "lb>a2"
     ]
    },
    {
     "text": "SET key NX with a TTL claims and expires in one operation: no cleanup job, and the primary loses a write per request.",
     "nodes": [
      "ks",
      "a1",
      "a2"
     ],
     "edges": [
      "a1>ks",
      "a2>ks"
     ]
    },
    {
     "text": "Cost: key and payment no longer commit together. Store the response before marking done, keep UNIQUE(order_id) in the DB, and run the store with replication and persistence; a store that forgets keys lets duplicates in.",
     "nodes": [
      "db"
     ],
     "edges": [
      "a1>db",
      "a2>db"
     ]
    }
   ]
  },
  {
