 ],
 "steps": [
  {
   "text": "Insert (key, request_hash, status = in_progress). The unique constraint means exactly one attempt can win.",
   "nodes": [
    "in",
    "claim",
    "new"
   ],
   "edges": [
    "in>claim",
    "claim>new"
   ]
  },
  {
   "text": "Won the claim: do the side effect, then store status = done and the response. For a local write, do both in one transaction.",
   "nodes": [
    "work",
    "save",
    "ok"
   ],
   "edges": [
    "new>work",
    "work>save",
    "save>ok"
   ]
  },
  {
   "text": "Lost the claim: first compare fingerprints. Same key with a different amount is a client bug, so refuse it instead of replaying the wrong answer.",
   "nodes": [
    "hash",
    "reuse"
   ],
   "edges": [
    "new>hash",
    "hash>reuse"
   ]
  },
  {
   "text": "Same request and already done: replay the stored response.",
   "nodes": [
    "done",
    "replay"
   ],
   "edges": [
    "hash>done",
    "done>replay"
   ]
  },
  {
   "text": "Same request still in progress (the first attempt is running): answer 409 so the client backs off and retries later.",
   "nodes": [
    "done",
    "busy"
   ],
   "edges": [
    "done>busy"
   ]
  }
 ]
