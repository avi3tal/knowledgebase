   "label": "Key was new?",
   "col": 0,
   "row": 2
  },
  {
   "id": "work",
   "type": "step",
   "label": "Do the work",
   "col": 0,
   "row": 3
  },
  {
   "id": "save",
   "type": "step",
   "label": "Store response",
   "col": 0,
   "row": 4
  },
  {
