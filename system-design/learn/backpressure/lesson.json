      "view": [
        {
          "id": "arrivals",
          "type": "array",
          "var": "arrivals",
          "label": "requests arriving per tick",
          "pointers": {
            "tick": "tick"
          }
        },
        {
          "id": "pending",
          "type": "array",
          "var": "pending",
          "label": "waiting at the producer"
