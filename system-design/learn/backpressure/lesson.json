    {
      "type": "trace",
      "id": "waiting-room",
      "title": "Waiting room — admit 2 per tick, line of 4, ETA up front",
      "source": "examples/waiting_room.py",
      "function": "waiting_room",
      "input": {
        "arrivals": [5, 3, 0, 1],
        "admit": 2,
        "room_size": 4
      },
      "view": [
        {
          "id": "arrivals",
          "type": "array",
          "var": "arrivals",
          "label": "users arriving per tick",
          "pointers": {
            "tick": "tick"
          }
        },
        {
          "id": "line",
          "type": "array",
          "var": "line",
          "label": "waiting line (head first)"
        },
        {
          "id": "eta",
          "type": "map",
          "var": "eta",
          "label": "ETA shown to each user (ticks)"
        },
        {
          "id": "admitted",
          "type": "array",
          "var": "admitted",
          "label": "admitted to the service"
        },
        {
          "id": "vars",
          "type": "vars",
          "vars": ["tick", "user", "turned_away"]
        }
      ],
      "checks": [
        {
          "input": {
            "arrivals": [5, 3, 0, 1],
            "admit": 2,
            "room_size": 4
          },
          "expected": {
            "admitted": ["u1", "u2", "u3", "u4", "u6", "u7", "u9"],
            "turned_away": 2,
            "eta": {
              "u1": 0,
              "u2": 0,
              "u3": 1,
              "u4": 1,
              "u6": 1,
              "u7": 1,
              "u9": 0
            }
          }
        },
        {
          "input": {
            "arrivals": [2],
            "admit": 1,
            "room_size": 5
          },
          "expected": {
            "admitted": ["u1", "u2"],
            "turned_away": 0,
            "eta": {
              "u1": 0,
              "u2": 1
            }
          }
        },
        {
          "input": {
            "arrivals": [],
            "admit": 2,
            "room_size": 3
          },
          "expected": {
            "admitted": [],
            "turned_away": 0,
            "eta": {}
          }
        }
      ]
