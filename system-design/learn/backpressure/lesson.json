        {
          "id": "vars",
          "type": "vars",
          "vars": ["policy", "tick", "served", "dropped", "max_pending"]
        }
      ],
      "checks": [
        {
          "input": {
            "arrivals": [4, 4, 0],
            "capacity": 3,
            "rate": 2,
            "policy": "block"
          },
          "expected": {
            "served": 8,
            "dropped": 0,
            "max_pending": 3,
            "ticks": 4
          }
        },
        {
          "input": {
            "arrivals": [4, 4, 0],
            "capacity": 3,
            "rate": 2,
            "policy": "drop"
          },
          "expected": {
            "served": 5,
            "dropped": 3,
            "max_pending": 0,
            "ticks": 3
          }
        },
        {
          "input": {
            "arrivals": [4, 4, 0],
            "capacity": 3,
            "rate": 2,
            "policy": "pace"
          },
          "expected": {
            "served": 8,
            "dropped": 0,
            "max_pending": 4,
            "ticks": 4
          }
        },
        {
          "input": {
            "arrivals": [1, 1],
            "capacity": 3,
            "rate": 2,
            "policy": "drop"
          },
          "expected": {
            "served": 2,
            "dropped": 0,
            "max_pending": 0,
            "ticks": 2
          }
        }
      ]
    },
