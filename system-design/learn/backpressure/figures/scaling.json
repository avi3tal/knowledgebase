 "steps": [
  {
   "text": "The API accepts everything and appends it to an in-memory queue.",
   "nodes": [
    "c",
    "api",
    "q"
   ],
   "edges": [
    "c>api",
    "api>q"
   ]
  },
  {
   "text": "A burst is absorbed. Sustained overload isn't: at 400/s in and 250/s out the backlog grows by 150 every second.",
   "nodes": [
    "q",
    "w"
   ],
   "edges": [
    "q>w"
   ]
  },
  {
   "text": "After minutes the wait exceeds every client timeout, and then memory runs out and the process dies with the queue inside it.",
   "nodes": [
    "q"
   ],
   "fail": [
    "q"
   ]
  }
 ],
