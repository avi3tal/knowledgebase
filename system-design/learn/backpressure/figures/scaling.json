 "steps": [
  {
   "text": "The API accepts everything and appends it to an in-memory queue.",
   "nodes": [
    "m",
    "api",
    "q"
   ],
   "edges": [
    "m>api",
    "api>q"
   ]
  },
  {
   "text": "At midnight 40 000 batches/s arrive and the workers finish 8 000/s: the backlog grows by 32 000 every second, and after two minutes ~4 M readings sit in RAM.",
   "nodes": [
    "q",
    "w"
   ],
   "edges": [
    "q>w"
   ]
  },
  {
   "text": "Memory runs out and the process dies with the queue inside it: billing reads are lost, and the meters were told they had been delivered.",
