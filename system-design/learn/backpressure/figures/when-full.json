 "steps": [
  {
   "text": "Room in the queue: enqueue. This is the normal case, and short bursts never get further.",
   "nodes": [
    "in",
    "full",
    "enq"
   ],
   "edges": [
    "in>full",
    "full>enq"
   ]
  },
  {
   "text": "Full, and the sender listens to feedback (credits, Retry-After, a rate it's told): ask it to send at most the consumer's rate. Smoothest outcome.",
   "nodes": [
    "fb",
    "pace"
   ],
   "edges": [
    "full>fb",
    "fb>pace"
   ]
  },
  {
   "text": "No feedback channel, but the work must not be lost (payments, writes): make the sender wait, always with a timeout. The delay moves upstream.",
   "nodes": [
    "keep",
    "block"
   ],
   "edges": [
    "fb>keep",
    "keep>block"
   ]
  },
  {
   "text": "Otherwise shed: reject with 429/503 plus Retry-After, drop the oldest, or sample. Latency stays low and the service stays up; this work is lost.",
   "nodes": [
    "drop"
   ],
   "edges": [
    "keep>drop"
   ]
  }
 ]
}
