 "title": "Cycle in an implicit sequence — is 172 a happy number?",
 "code": [
  "def is_happy(n: int) -> bool:",
  "    def next_of(x: int) -> int:",
  "        total = 0",
  "        while x > 0:",
  "            x, digit = divmod(x, 10)",
  "            total += digit * digit",
  "        return total",
  "",
  "    slow, fast = n, next_of(n)",
  "    while fast != 1 and slow != fast:",
  "        slow = next_of(slow)",
  "        fast = next_of(next_of(fast))",
  "    return fast == 1"
 ],
