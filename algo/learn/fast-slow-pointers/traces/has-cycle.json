{
 "version": 1,
 "title": "Floyd's cycle detection — does the linked list loop?",
 "code": [
  "def has_cycle(head) -> bool:",
  "    slow = fast = head",
  "    while fast is not None and fast.next is not None:",
  "        slow = slow.next",
  "        fast = fast.next.next",
  "        if slow is fast:",
  "            return True",
  "    return False"
 ],
