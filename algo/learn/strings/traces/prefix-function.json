{
 "version": 1,
 "title": "KMP prefix function — is the string one block repeated?",
 "code": [
  "def is_repeated_block(s: str) -> bool:",
  "    n = len(s)",
  "    if n == 0:",
  "        return False",
  "    lps = [0] * n",
  "    k = 0",
  "    for i in range(1, n):",
  "        while k > 0 and s[i] != s[k]:",
  "            k = lps[k - 1]",
  "        if s[i] == s[k]:",
  "            k += 1",
  "        lps[i] = k",
  "    period = n - lps[-1]",
  "    return lps[-1] > 0 and n % period == 0"
 ],
