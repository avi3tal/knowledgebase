{
 "version": 1,
 "title": "Heap of tuples: always run the shortest job that has arrived",
 "code": [
  "def shortest_job_first(jobs: list[list[int]]) -> list[int]:",
  "    order = sorted(range(len(jobs)), key=lambda j: jobs[j][0])",
  "    ready: list[tuple[int, int]] = []",
  "    time, k, done = 0, 0, []",
  "    while len(done) < len(jobs):",
  "        while k < len(order) and jobs[order[k]][0] <= time:",
  "            job = order[k]",
  "            heapq.heappush(ready, (jobs[job][1], job))",
  "            k += 1",
  "        if not ready:",
  "            time = jobs[order[k]][0]",
  "            continue",
  "        duration, job = heapq.heappop(ready)",
  "        time += duration",
  "        done.append(job)",
  "    return done"
 ],
