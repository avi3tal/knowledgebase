{
 "version": 1,
 "title": "Opposite ends — squares of a sorted array",
 "code": [
  "def sorted_squares(nums: list[int]) -> list[int]:",
  "    n = len(nums)",
  "    result = [0] * n",
  "    left, right = 0, n - 1",
  "    for fill in range(n - 1, -1, -1):",
  "        left_sq, right_sq = nums[left] ** 2, nums[right] ** 2",
  "        if left_sq > right_sq:",
  "            result[fill] = left_sq",
  "            left += 1",
  "        else:",
  "            result[fill] = right_sq",
  "            right -= 1",
  "    return result"
 ],
