{
 "version": 1,
 "title": "BFS flood fill — the same count, spreading with a queue",
 "code": [
  "def count_islands_bfs(grid: list[str]) -> int:",
  "    rows, cols = len(grid), len(grid[0])",
  "    seen = set()",
  "    count = 0",
  "    for r in range(rows):",
  "        for c in range(cols):",
  "            if grid[r][c] != \"1\" or (r, c) in seen:",
  "                continue",
  "            count += 1",
  "            seen.add((r, c))",
  "            queue = deque([(r, c)])",
  "            while queue:",
  "                cr, cc = queue.popleft()",
  "                for nr, nc in ((cr + 1, cc), (cr - 1, cc), (cr, cc + 1), (cr, cc - 1)):",
  "                    if 0 <= nr < rows and 0 <= nc < cols and grid[nr][nc] == \"1\" and (nr, nc) not in seen:",
  "                        seen.add((nr, nc))",
  "                        queue.append((nr, nc))",
  "    return count"
 ],
