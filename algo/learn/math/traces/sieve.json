{
 "version": 1,
 "title": "Sieve of Eratosthenes — count the primes below n",
 "code": [
  "def count_primes(n: int) -> int:",
  "    if n < 3:",
  "        return 0",
  "    is_prime = [True] * n",
  "    is_prime[0] = is_prime[1] = False",
  "    p = 2",
  "    while p * p < n:",
  "        if is_prime[p]:",
  "            for multiple in range(p * p, n, p):",
  "                is_prime[multiple] = (",
  "                    False",
  "                )",
  "        p += 1",
  "    return sum(is_prime)"
 ],
