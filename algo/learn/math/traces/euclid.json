 "title": "Euclid's algorithm — gcd and lcm",
 "code": [
  "def gcd_lcm(x: int, y: int) -> list[int]:",
  "    a, b = x, y",
  "    while b:",
  "        remainder = a % b",
  "        a, b = b, remainder",
  "    gcd = a",
  "    lcm = x // gcd * y",
  "    return [gcd, lcm]"
 ],
