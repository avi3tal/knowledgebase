{
 "version": 1,
 "title": "Bitmasks as letter sets — max product of disjoint words",
 "code": [
  "def max_word_product(words: list[str]) -> int:",
  "    masks = []",
  "    for word in words:",
  "        mask = 0",
  "        for ch in word:",
  "            mask |= 1 << (ord(ch) - ord(\"a\"))",
  "        masks.append(mask)",
  "    best = 0",
  "    for i in range(len(words)):",
  "        for j in range(i + 1, len(words)):",
  "            shared = masks[i] & masks[j]",
  "            if shared == 0:",
  "                best = max(best, len(words[i]) * len(words[j]))",
  "    return best"
 ],
