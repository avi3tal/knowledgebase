{
 "version": 1,
 "title": "n & (n − 1) — count set bits one at a time",
 "code": [
  "def count_set_bits(n: int) -> int:",
  "    count = 0",
  "    binary = list(format(n, \"08b\"))",
  "    while n:",
  "        lower = n - 1",
  "        n &= lower",
  "        binary[:] = format(n, \"08b\")",
  "        count += 1",
  "    return count"
 ],
