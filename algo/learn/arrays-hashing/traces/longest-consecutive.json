{
 "version": 1,
 "title": "Hash set: longest run of consecutive integers",
 "code": [
  "def longest_consecutive(nums: list[int]) -> int:",
  "    seen = set(nums)",
  "    best = 0",
  "    for x in nums:",
  "        if x - 1 in seen:",
  "            continue",
  "        length = 1",
  "        while x + length in seen:",
  "            length += 1",
  "        best = max(best, length)",
  "    return best"
 ],
