{
 "version": 1,
 "title": "Boyer-Moore vote — majority element in O(1) space",
 "code": [
  "def majority_element(nums: list[int]) -> int:",
  "    candidate = nums[0]",
  "    count = 0",
  "    for x in nums:",
  "        if count == 0:",
  "            candidate = x",
  "        if x == candidate:",
  "            count += 1",
  "        else:",
  "            count -= 1",
  "    return candidate"
 ],
