{
 "version": 1,
 "title": "Prefix sum + hash map: count subarrays with sum k (negatives allowed)",
 "code": [
  "def count_subarrays_sum_k(nums: list[int], k: int) -> int:",
  "    seen = {0: 1}",
  "    prefix, count = 0, 0",
  "    for i in range(len(nums)):",
  "        prefix += nums[i]",
  "        need = prefix - k",
  "        count += seen.get(need, 0)",
  "        seen[prefix] = seen.get(prefix, 0) + 1",
  "    return count"
 ],
