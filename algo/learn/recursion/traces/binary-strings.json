 "title": "Tree recursion: all binary strings of length n",
 "code": [
  "def binary_strings(n: int) -> list[str]:",
  "    out: list[str] = []",
  "",
  "    def build(prefix: str) -> None:",
  "        if len(prefix) == n:",
  "            out.append(prefix)",
  "            return",
  "        build(prefix + \"0\")",
  "        build(prefix + \"1\")",
  "",
  "    build(\"\")",
  "    return out"
