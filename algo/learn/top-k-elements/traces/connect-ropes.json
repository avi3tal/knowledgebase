{
 "version": 1,
 "title": "Repeated extraction: minimum cost to connect ropes",
 "code": [
  "def connect_ropes(ropes: list[int]) -> int:",
  "    heap = list(ropes)",
  "    heapq.heapify(heap)",
  "    total = 0",
  "    while len(heap) > 1:",
  "        a = heapq.heappop(heap)",
  "        b = heapq.heappop(heap)",
  "        joined = a + b",
  "        total += joined",
  "        heapq.heappush(heap, joined)",
  "    return total"
 ],
