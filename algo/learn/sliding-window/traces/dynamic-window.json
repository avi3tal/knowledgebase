{
 "version": 1,
 "title": "Dynamic window — longest substring with at most k distinct characters",
 "code": [
  "def longest_k_distinct(s: str, k: int) -> int:",
  "    counts: dict[str, int] = {}",
  "    window_start, best = 0, 0",
  "    for window_end in range(len(s)):",
  "        right = s[window_end]",
  "        counts[right] = counts.get(right, 0) + 1",
  "        while len(counts) > k:",
  "            left = s[window_start]",
  "            counts[left] -= 1",
  "            if counts[left] == 0:",
  "                del counts[left]",
  "            window_start += 1",
  "        best = max(best, window_end - window_start + 1)",
  "    return best"
 ],
