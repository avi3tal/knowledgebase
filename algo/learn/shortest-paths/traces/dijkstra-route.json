{
 "version": 1,
 "title": "Dijkstra — cheapest route with path reconstruction",
 "code": [
  "def cheapest_route(n: int, roads: list[list[int]], src: int, dst: int) -> list:",
  "    graph: dict[int, list[tuple[int, int]]] = {i: [] for i in range(n)}",
  "    for a, b, cost in roads:",
  "        graph[a].append((b, cost))",
  "        graph[b].append((a, cost))",
  "    dist = {src: 0}",
  "    prev: dict[int, int] = {}",
  "    heap = [(0, src)]",
  "    while heap:",
  "        d, node = heapq.heappop(heap)",
  "        if node == dst:",
  "            break",
  "        if d > dist[node]:",
  "            continue",
  "        for nxt, w in graph[node]:",
  "            if d + w < dist.get(nxt, float(\"inf\")):",
  "                dist[nxt] = d + w",
  "                prev[nxt] = node",
  "                heapq.heappush(heap, (d + w, nxt))",
  "    if dst not in dist:",
  "        return [-1, []]",
  "    route = [dst]",
  "    while route[-1] != src:",
  "        route.append(prev[route[-1]])",
  "    return [dist[dst], route[::-1]]"
 ],
