{
 "version": 1,
 "title": "Pairs cancel out — find the number that appears once",
 "code": [
  "def single_number(nums: list[int]) -> int:",
  "    acc = 0",
  "    binary = {\"x\": \"----\", \"acc\": format(acc, \"04b\")}",
  "    for i in range(len(nums)):",
  "        x = nums[i]",
  "        binary[\"x\"] = format(x, \"04b\")",
  "        acc ^= x",
  "        binary[\"acc\"] = format(acc, \"04b\")",
  "    return acc"
 ],
