{
 "version": 1,
 "title": "Insertion sort — slide each element into the sorted prefix",
 "code": [
  "def insertion_sort(nums: list[int]) -> list[int]:",
  "    nums = list(nums)",
  "    for i in range(1, len(nums)):",
  "        key = nums[i]",
  "        j = i - 1",
  "        while j >= 0 and nums[j] > key:",
  "            nums[j + 1] = nums[j]",
  "            j -= 1",
  "        nums[j + 1] = key",
  "    return nums"
 ],
