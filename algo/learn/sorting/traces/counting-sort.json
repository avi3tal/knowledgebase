{
 "version": 1,
 "title": "Stable counting sort — counts, prefix sums, placement",
 "code": [
  "def counting_sort(nums: list[int], max_value: int) -> list[int]:",
  "    counts = [0] * (max_value + 1)",
  "    for x in nums:",
  "        counts[x] += 1",
  "    start = 0",
  "    for v in range(max_value + 1):",
  "        counts[v], start = start, start + counts[v]",
  "    output = [0] * len(nums)",
  "    for x in nums:",
  "        output[counts[x]] = x",
  "        counts[x] += 1",
  "    return output"
 ],
