{
 "version": 1,
 "title": "Interval scheduling — sort by end, take what fits",
 "code": [
  "def max_meetings(meetings: list[list[int]]) -> int:",
  "    meetings = sorted(",
  "        meetings, key=lambda m: m[1]",
  "    )",
  "    chosen: list[list[int]] = []",
  "    last_end = float(\"-inf\")",
  "    for i in range(len(meetings)):",
  "        start, end = meetings[i]",
  "        if start >= last_end:",
  "            chosen.append(meetings[i])",
  "            last_end = end",
  "    return len(chosen)"
 ],
