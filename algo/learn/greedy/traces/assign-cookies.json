 "version": 1,
 "title": "Two sorted lists — smallest cookie that satisfies the least demanding child",
 "code": [
  "def assign_cookies(needs: list[int], sizes: list[int]) -> int:",
  "    needs, sizes = sorted(needs), sorted(sizes)",
  "    child = 0",
  "    for cookie in range(",
  "        len(sizes)",
  "    ):",
  "        if child < len(needs) and sizes[cookie] >= needs[child]:",
  "            child += 1",
  "    return child"
 ],
