{
 "version": 1,
 "title": "Monotonic stack: next greater element to the right",
 "code": [
  "def next_greater(nums: list[int]) -> list[int]:",
  "    result = [-1] * len(nums)",
  "    stack: list[int] = []",
  "    for i in range(len(nums)):",
  "        while stack and nums[stack[-1]] < nums[i]:",
  "            j = stack.pop()",
  "            result[j] = nums[i]",
  "        stack.append(i)",
  "    return result"
 ],
