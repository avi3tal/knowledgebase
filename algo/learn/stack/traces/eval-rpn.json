{
 "version": 1,
 "title": "Plain stack: evaluate a postfix (reverse Polish) expression",
 "code": [
  "def eval_rpn(tokens: list[str]) -> int:",
  "    stack: list[int] = []",
  "    for i in range(len(tokens)):",
  "        tok = tokens[i]",
  "        if tok not in {\"+\", \"-\", \"*\", \"/\"}:",
  "            stack.append(int(tok))",
  "            continue",
  "        right = stack.pop()",
  "        left = stack.pop()",
  "        if tok == \"+\":",
  "            stack.append(left + right)",
  "        elif tok == \"-\":",
  "            stack.append(left - right)",
  "        elif tok == \"*\":",
  "            stack.append(left * right)",
  "        else:",
  "            stack.append(int(left / right))",
  "    return stack[-1]"
 ],
