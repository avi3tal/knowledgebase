{
 "version": 1,
 "title": "Counting overlaps with a heap of end times — maximum CPU load",
 "code": [
  "def max_cpu_load(jobs: list[list[int]]) -> int:",
  "    jobs = sorted(jobs)",
  "    running: list[tuple[int, int]] = []",
  "    load = best = 0",
  "    for i in range(len(jobs)):",
  "        start, end, job_load = jobs[i]",
  "        while running and running[0][0] <= start:",
  "            _, done_load = heapq.heappop(running)",
  "            load -= done_load",
  "        heapq.heappush(running, (end, job_load))",
  "        load += job_load",
  "        best = max(best, load)",
  "    return best"
 ],
