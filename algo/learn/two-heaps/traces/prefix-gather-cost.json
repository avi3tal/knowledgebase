{
 "version": 1,
 "title": "Running median: cheapest meeting point after each arrival",
 "code": [
  "def gather_costs(positions: list[int]) -> list[int]:",
  "    lo: list[int] = []  # max-heap via negation: -lo[0] is the largest of the small half",
  "    hi: list[int] = []  # min-heap: hi[0] is the smallest of the large half",
  "    lo_sum = hi_sum = 0",
  "    costs: list[int] = []",
  "    for x in positions:",
  "        if not lo or x <= -lo[0]:",
  "            heapq.heappush(lo, -x)",
  "            lo_sum += x",
  "        else:",
  "            heapq.heappush(hi, x)",
  "            hi_sum += x",
  "        if len(lo) > len(hi) + 1:",
  "            moved = -heapq.heappop(lo)",
  "            lo_sum -= moved",
  "            heapq.heappush(hi, moved)",
  "            hi_sum += moved",
  "        elif len(hi) > len(lo):",
  "            moved = heapq.heappop(hi)",
  "            hi_sum -= moved",
  "            heapq.heappush(lo, -moved)",
  "            lo_sum += moved",
  "        median = -lo[0]",
  "        below = median * len(lo) - lo_sum",
  "        above = hi_sum - median * len(hi)",
  "        cost = below + above",
  "        costs.append(cost)",
  "    return costs"
 ],
