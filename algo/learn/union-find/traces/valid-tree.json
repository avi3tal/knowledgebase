{
 "version": 1,
 "title": "Union by size + path halving — is the graph a tree?",
 "code": [
  "def valid_tree(n: int, edges: list[list[int]]) -> bool:",
  "    if len(edges) != n - 1:",
  "        return False",
  "    parent = list(range(n))",
  "    size = [1] * n",
  "",
  "    def find(x: int) -> int:",
  "        while parent[x] != x:",
  "            parent[x] = parent[parent[x]]",
  "            x = parent[x]",
  "        return x",
  "",
  "    for a, b in edges:",
  "        root_a, root_b = find(a), find(b)",
  "        if root_a == root_b:",
  "            return False",
  "        if size[root_a] < size[root_b]:",
  "            root_a, root_b = root_b, root_a",
  "        parent[root_b] = root_a",
  "        size[root_a] += size[root_b]",
  "    return True"
 ],
