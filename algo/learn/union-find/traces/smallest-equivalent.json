{
 "version": 1,
 "title": "Dict-based union-find — the smallest letter represents each group",
 "code": [
  "def smallest_equivalent(s1: str, s2: str, base: str) -> str:",
  "    parent: dict[str, str] = {}",
  "",
  "    def find(x: str) -> str:",
  "        parent.setdefault(x, x)",
  "        while parent[x] != x:",
  "            x = parent[x]",
  "        return x",
  "",
  "    for a, b in zip(s1, s2, strict=True):",
  "        root_a, root_b = find(a), find(b)",
  "        if root_a != root_b:",
  "            small, big = min(root_a, root_b), max(root_a, root_b)",
  "            parent[big] = small",
  "    return \"\".join(find(c) for c in base)"
 ],
