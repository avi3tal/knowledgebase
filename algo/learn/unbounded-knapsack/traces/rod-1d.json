{
 "version": 1,
 "title": "One row — rod length left-to-right",
 "code": [
  "def rod_cutting_1d(lengths: list[int], prices: list[int], n: int) -> int:",
  "    dp = [0] * (n + 1)",
  "    for i in range(len(lengths)):",
  "        size, price = lengths[i], prices[i]",
  "        for r in range(size, n + 1):",
  "            dp[r] = max(dp[r], dp[r - size] + price)",
  "    return dp[n]"
 ],
