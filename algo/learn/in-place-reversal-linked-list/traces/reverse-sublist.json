{
 "version": 1,
 "title": "Reverse the sub-list from position 2 to 6",
 "code": [
  "def reverse_sublist(head, p: int, q: int):",
  "    if p == q:",
  "        return head",
  "    before, curr = None, head",
  "    for _ in range(p - 1):",
  "        before, curr = curr, curr.next",
  "    sub_tail = curr",
  "    prev = None",
  "    for _ in range(q - p + 1):",
  "        nxt = curr.next",
  "        curr.next = prev",
  "        prev, curr = curr, nxt",
  "    if before is not None:",
  "        before.next = prev",
  "    else:",
  "        head = prev",
  "    sub_tail.next = curr",
  "    return head"
 ],
