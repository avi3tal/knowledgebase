{
 "version": 1,
 "title": "Lower bound — ceiling of a key in a sorted array",
 "code": [
  "def search_ceiling(nums: list[int], key: int) -> int:",
  "    if not nums or key > nums[-1]:",
  "        return -1",
  "    lo, hi = 0, len(nums) - 1",
  "    while lo <= hi:",
  "        mid = lo + (hi - lo) // 2",
  "        if nums[mid] < key:",
  "            lo = mid + 1",
  "        elif nums[mid] > key:",
  "            hi = mid - 1",
  "        else:",
  "            return mid",
  "    return lo"
 ],
