{
 "version": 1,
 "title": "Boundary search — first and last position of a target",
 "code": [
  "def search_range(nums: list[int], target: int) -> list[int]:",
  "    def boundary(find_first: bool) -> int:",
  "        found = -1",
  "        lo, hi = 0, len(nums) - 1",
  "        while lo <= hi:",
  "            mid = lo + (hi - lo) // 2",
  "            if nums[mid] < target:",
  "                lo = mid + 1",
  "            elif nums[mid] > target:",
  "                hi = mid - 1",
  "            else:",
  "                found = mid",
  "                if find_first:",
  "                    hi = mid - 1",
  "                else:",
  "                    lo = mid + 1",
  "        return found",
  "",
  "    first = boundary(True)",
  "    last = boundary(False)",
  "    return [first, last]"
 ],
