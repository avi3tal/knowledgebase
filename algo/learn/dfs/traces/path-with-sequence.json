{
 "version": 1,
 "title": "Recursive DFS with a path — does a root-to-leaf path spell the sequence?",
 "code": [
  "def has_sequence(root, sequence: list[int]) -> bool:",
  "    path = []",
  "",
  "    def dfs(node, i: int) -> bool:",
  "        if node is None or i >= len(sequence) or node.val != sequence[i]:",
  "            return False",
  "        path.append(node)",
  "        if node.left is None and node.right is None:",
  "            if i == len(sequence) - 1:",
  "                return True",
  "        elif dfs(node.left, i + 1) or dfs(node.right, i + 1):",
  "            return True",
  "        path.pop()",
  "        return False",
  "",
  "    return dfs(root, 0)"
 ],
