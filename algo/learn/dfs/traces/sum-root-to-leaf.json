{
 "version": 1,
 "title": "Iterative DFS with an explicit stack — sum of root-to-leaf numbers",
 "code": [
  "def sum_numbers(root) -> int:",
  "    if root is None:",
  "        return 0",
  "    total = 0",
  "    stack = [(root, root.val)]",
  "    while stack:",
  "        node, number = stack.pop()",
  "        if node.left is None and node.right is None:",
  "            total += number",
  "            continue",
  "        if node.right:",
  "            stack.append((node.right, number * 10 + node.right.val))",
  "        if node.left:",
  "            stack.append((node.left, number * 10 + node.left.val))",
  "    return total"
 ],
