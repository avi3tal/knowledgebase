{
 "version": 1,
 "title": "Top-down — staircase with a memo (watch the cache hits cut the recursion)",
 "code": [
  "def count_ways_memo(n: int) -> int:",
  "    memo: dict[int, int] = {}",
  "",
  "    def ways(k: int) -> int:",
  "        if k < 0:",
  "            return 0",
  "        if k == 0:",
  "            return 1",
  "        if k in memo:",
  "            return memo[k]",
  "        memo[k] = ways(k - 1) + ways(k - 2) + ways(k - 3)",
  "        return memo[k]",
  "",
  "    return ways(n)"
 ],
