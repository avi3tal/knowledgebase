 "title": "Bottom-up — staircase in a 1-D array",
 "code": [
  "def count_ways(n: int) -> int:",
  "    dp = [0] * (n + 1)",
  "    dp[0] = 1",
  "    for i in range(1, n + 1):",
  "        one = dp[i - 1]",
  "        two = dp[i - 2] if i >= 2 else 0",
  "        three = dp[i - 3] if i >= 3 else 0",
  "        dp[i] = one + two + three",
  "    return dp[n]"
 ],
