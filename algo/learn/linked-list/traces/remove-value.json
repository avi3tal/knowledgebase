{
 "version": 1,
 "title": "Dummy head: remove every node equal to a target",
 "code": [
  "def remove_value(head, target: int):",
  "    dummy = ListNode(",
  "        0, head",
  "    )",
  "    prev, curr = dummy, head",
  "    while curr is not None:",
  "        if curr.val == target:",
  "            prev.next = curr.next",
  "        else:",
  "            prev = curr",
  "        curr = curr.next",
  "    return dummy.next"
 ],
