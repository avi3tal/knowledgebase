{
 "version": 1,
 "title": "Splicing: insertion sort on a linked list",
 "code": [
  "def insertion_sort_list(head):",
  "    dummy = ListNode(0)",
  "    curr = head",
  "    while curr is not None:",
  "        nxt = curr.next",
  "        prev = dummy",
  "        while prev.next is not None and prev.next.val < curr.val:",
  "            prev = prev.next",
  "        curr.next = prev.next",
  "        prev.next = curr",
  "        curr = nxt",
  "    return dummy.next"
 ],
