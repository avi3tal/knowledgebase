{
 "version": 1,
 "title": "Place every value at its home index — sort 1..n in place",
 "code": [
  "def cyclic_sort(nums: list[int]) -> list[int]:",
  "    i = 0",
  "    while i < len(nums):",
  "        j = nums[i] - 1",
  "        if nums[i] != nums[j]:",
  "            nums[i], nums[j] = nums[j], nums[i]",
  "        else:",
  "            i += 1",
  "    return nums"
 ],
