 "version": 1,
 "title": "Place, then scan — find the duplicated and the missing number",
 "code": [
  "def find_corrupt_pair(nums: list[int]) -> list[int]:",
  "    i = 0",
  "    while i < len(nums):",
  "        j = nums[i] - 1",
  "        if nums[i] != nums[j]:",
  "            nums[i], nums[j] = nums[j], nums[i]",
  "        else:",
  "            i += 1",
  "    for k in range(len(nums)):",
  "        if nums[k] != k + 1:",
  "            return [nums[k], k + 1]",
  "    return [-1, -1]"
 ],
