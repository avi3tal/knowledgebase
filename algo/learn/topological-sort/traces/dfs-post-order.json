{
 "version": 1,
 "title": "DFS variant — reverse post-order, with cycle detection",
 "code": [
  "def dfs_topological_order(n: int, edges: list[list[int]]) -> list[int]:",
  "    graph: dict[int, list[int]] = {v: [] for v in range(n)}",
  "    for u, v in edges:",
  "        graph[u].append(v)",
  "    state: dict[int, str] = {}  # missing = unvisited, \"active\" = on the current path, \"done\" = finished",
  "    finished: list[int] = []",
  "    has_cycle = False",
  "",
  "    def dfs(node: int) -> None:",
  "        nonlocal has_cycle",
  "        state[node] = \"active\"",
  "        for nxt in graph[node]:",
  "            if state.get(nxt) == \"active\":",
  "                has_cycle = True",
  "            elif nxt not in state:",
  "                dfs(nxt)",
  "        state[node] = \"done\"",
  "        finished.append(node)",
  "",
  "    for v in range(n):",
  "        if v not in state:",
  "            dfs(v)",
  "    if has_cycle:",
  "        return []",
  "    return finished[::-1]"
 ],
