{
 "version": 1,
 "title": "DFS in a trie — match a pattern with '.' wildcards",
 "code": [
  "def wildcard_search(words: list[str], pattern: str) -> bool:",
  "    root: dict = {}",
  "    for word in words:",
  "        node = root",
  "        for ch in word:",
  "            node = node.setdefault(ch, {})",
  "        node[\"$\"] = True",
  "",
  "    def match(node: dict, i: int) -> bool:",
  "        if i == len(pattern):",
  "            return \"$\" in node",
  "        ch = pattern[i]",
  "        if ch == \".\":",
  "            for key, child in node.items():",
  "                if key != \"$\" and match(child, i + 1):",
  "                    return True",
  "            return False",
  "        if ch not in node:",
  "            return False",
  "        return match(node[ch], i + 1)",
  "",
  "    return match(root, 0)"
 ],
