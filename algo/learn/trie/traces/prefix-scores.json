{
 "version": 1,
 "title": "Trie with counts — sum of prefix scores",
 "code": [
  "def prefix_scores(words: list[str]) -> list[int]:",
  "    root: dict = {}",
  "    for word in words:",
  "        node = root",
  "        for ch in word:",
  "            node = node.setdefault(ch, {\"#\": 0})",
  "            node[\"#\"] += 1",
  "    scores = []",
  "    for word in words:",
  "        node, score = root, 0",
  "        for ch in word:",
  "            node = node[ch]",
  "            score += node[\"#\"]",
  "        scores.append(score)",
  "    return scores"
 ],
