{
 "version": 1,
 "title": "k choices per position — letter combinations of a phone number",
 "code": [
  "def letter_combinations(digits: str) -> list[str]:",
  "    if not digits:",
  "        return []",
  "    combos = [\"\"]",
  "    for digit in digits:",
  "        letters = KEYPAD[digit]",
  "        next_level = []",
  "        for prefix in combos:",
  "            for letter in letters:",
  "                next_level.append(prefix + letter)",
  "        combos = next_level",
  "    return combos"
 ],
