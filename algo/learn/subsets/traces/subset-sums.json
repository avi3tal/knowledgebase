 "version": 1,
 "title": "BFS subsets — the sum of every subset",
 "code": [
  "def subset_sums(nums: list[int]) -> list[int]:",
  "    sums = [0]",
  "    for num in nums:",
  "        size = len(sums)",
  "        for i in range(size):",
  "            sums.append(sums[i] + num)",
  "    return sums"
 ],
