{
 "version": 1,
 "title": "Merge 3 sorted arrays with a heap of their heads",
 "code": [
  "def merge_k_sorted(arrays: list[list[int]]) -> list[int]:",
  "    heap: list[tuple[int, int, int]] = []",
  "    for i in range(len(arrays)):",
  "        if arrays[i]:",
  "            heapq.heappush(heap, (arrays[i][0], i, 0))",
  "    merged: list[int] = []",
  "    taken: list[tuple[int, int]] = []",
  "    while heap:",
  "        value, i, j = heapq.heappop(heap)",
  "        merged.append(value)",
  "        taken.append((i, j))",
  "        if j + 1 < len(arrays[i]):",
  "            heapq.heappush(heap, (arrays[i][j + 1], i, j + 1))",
  "    return merged"
 ],
