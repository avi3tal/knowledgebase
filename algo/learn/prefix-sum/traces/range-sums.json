{
 "version": 1,
 "title": "Build prefix sums, then answer range queries in O(1)",
 "code": [
  "def range_sums(nums: list[int], queries: list[list[int]]) -> list[int]:",
  "    prefix = [0] * (len(nums) + 1)",
  "    for i in range(len(nums)):",
  "        prefix[i + 1] = prefix[i] + nums[i]",
  "    answers = []",
  "    for left, right in queries:",
  "        end = right + 1",
  "        answers.append(prefix[end] - prefix[left])",
  "    return answers"
 ],
