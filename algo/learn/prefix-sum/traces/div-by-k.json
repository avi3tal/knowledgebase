{
 "version": 1,
 "title": "Prefix remainders + hash map — subarrays divisible by k",
 "code": [
  "def subarrays_div_by_k(nums: list[int], k: int) -> int:",
  "    seen = {0: 1}",
  "    prefix, count = 0, 0",
  "    for i in range(len(nums)):",
  "        prefix += nums[i]",
  "        mod = prefix % k",
  "        count += seen.get(mod, 0)",
  "        seen[mod] = seen.get(mod, 0) + 1",
  "    return count"
 ],
