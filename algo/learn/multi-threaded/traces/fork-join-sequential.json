{
 "version": 1,
 "title": "Fork–join, traced sequentially — sum of a binary tree (where the parallel split goes)",
 "code": [
  "def tree_sum(root) -> int:",
  "    def total(node) -> int:",
  "        if node is None:",
  "            return 0",
  "        left = total(node.left)",
  "        right = total(node.right)",
  "        return node.val + left + right",
  "",
  "    return total(root)"
