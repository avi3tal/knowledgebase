  {"name": "root longer than word", "args": {"dictionary": ["catt"], "sentence": "cat"}, "expected": "cat"},
  {"name": "root equals word", "args": {"dictionary": ["cat"], "sentence": "cat cat"}, "expected": "cat cat"},
  {"name": "single word replaced", "args": {"dictionary": ["re"], "sentence": "replace"}, "expected": "re"},
  {"name": "no match mid-walk", "args": {"dictionary": ["abc"], "sentence": "abd abcd ab"}, "expected": "abd abc ab"},
